sf.ZIndex = 201
sf.Parent = f

local sfc = Instance.new("UICorner")
sfc.CornerRadius = UDim.new(0, 6)
sfc.Parent = sf

local tb = Instance.new("TextBox")
tb.Size = UDim2.new(1, -16, 0, 5000)
tb.Position = UDim2.new(0, 8, 0, 8)
tb.BackgroundTransparency = 1
tb.Text = "UI loaded successfully.\nScanning..."
tb.TextColor3 = Color3.fromRGB(220, 220, 230)
tb.Font = Enum.Font.Code
tb.TextSize = 11
tb.TextXAlignment = Enum.TextXAlignment.Left
tb.TextYAlignment = Enum.TextYAlignment.Top
tb.MultiLine = true
tb.TextEditable = true
tb.ClearTextOnFocus = false
tb.TextWrapped = true
tb.ZIndex = 202
tb.Parent = sf

local out = {}
local function add(s)
    table.insert(out, tostring(s))
    tb.Text = table.concat(out, "\n")
    sf.CanvasSize = UDim2.new(0, 0, 0, #out * 16 + 40)
end

-- NOW do the scanning, with everything pcall'd
add("=== MY COOKIE STORE BUILD SCAN ===")
add("PlaceId: " .. tostring(game.PlaceId))
add("")

local keywords = {"item", "build", "furniture", "decor", "place", "shop", "catalog", "cookie", "store", "grid", "tile", "pixel", "block", "object", "prop"}

local function matchesKeyword(name)
    local lower = tostring(name):lower()
    for _, kw in ipairs(keywords) do
        if lower:find(kw, 1, true) then return kw end
    end
    return nil
end

local found = {}

-- Scan RS
add("--- ReplicatedStorage ---")
pcall(function()
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("Folder") or obj:IsA("Configuration") or obj:IsA("ModuleScript") then
            local kw = matchesKeyword(obj.Name)
            if kw then
                local kids = 0
                pcall(function() kids = #obj:GetChildren() end)
                add(string.format("[%s] %s | %s | %d kids | %s", kw:upper(), obj.Name, obj.ClassName, kids, obj:GetFullName()))
                table.insert(found, obj)
            end
        end
    end
end)
add("")

-- Scan Workspace top-level
add("--- Workspace top-level ---")
pcall(function()
    for _, obj in ipairs(WS:GetChildren()) do
        if obj:IsA("Folder") or obj:IsA("Model") then
            local kw = matchesKeyword(obj.Name)
            if kw then
                add(string.format("[%s] %s | %s | %d kids", kw:upper(), obj.Name, obj.ClassName, #obj:GetChildren()))
                table.insert(found, obj)
            end
        end
    end
end)
add("")

-- Scan PlayerGui
add("--- PlayerGui ---")
pcall(function()
    for _, obj in ipairs(PG:GetDescendants()) do
        local kw = matchesKeyword(obj.Name)
        if kw and (obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("Folder") or obj:IsA("ModuleScript")) then
            add(string.format("[%s] %s | %s | %d kids | %s", kw:upper(), obj.Name, obj.ClassName, #obj:GetChildren(), obj:GetFullName()))
            table.insert(found, obj)
        end
    end
end)
add("")

-- Pick the best container
local best = nil
local bestCount = 0
for _, obj in ipairs(found) do
    local cc2 = 0
    pcall(function() cc2 = #obj:GetChildren() end)
    if cc2 > bestCount and cc2 < 500 then
        best = obj
        bestCount = cc2
    end
end

if best then
    add("=== LIKELY CONTAINER ===")
    add(best:GetFullName())
    add("Children: " .. bestCount)
    add("")
    pcall(function()
        local shown = 0
        for _, child in ipairs(best:GetChildren()) do
            shown = shown + 1
            if shown > 30 then
                add("... and " .. (bestCount - 30) .. " more")
                break
            end
            local sizeInfo = ""
            if child:IsA("Model") then
                local part = child.PrimaryPart
                if not part then part = child:FindFirstChildWhichIsA("BasePart") end
                if part then
                    sizeInfo = string.format(" [part %.2f x %.2f x %.2f]", part.Size.X, part.Size.Y, part.Size.Z)
                end
            end
            local attrs = ""
            local ok, a = pcall(function() return child:GetAttributes() end)
            if ok and a then
                for k, v in pairs(a) do
                    attrs = attrs .. " " .. tostring(k) .. "=" .. tostring(v)
                end
            end
            add(string.format("  %s (%s)%s%s", child.Name, child.ClassName, sizeInfo, attrs ~= "" and (" {" .. attrs .. "}") or ""))
        end
    end)
else
    add("=== NO CONTAINER FOUND ===")
    add("Try: enter build mode, open item shop, then run again.")
end

add("")
add("=== DONE ===")

local text = table.concat(out, "\n")
local copied = false
pcall(function() if setclipboard then setclipboard(text); copied = true end end)
if not copied then pcall(function() if toclipboard then toclipboard(text); copied = true end end) end

title.Text = "Cookie Store Scan — " .. (copied and "copied to clipboard" or "DONE")
add("")
add("Clipboard: " .. (copied and "OK" or "FAILED — copy manually from this box"))
