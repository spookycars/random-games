local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local FORCEFIELD_NAMES = {
    forcefield = true, shield = true, spawnshield = true,
    spawnprotection = true, invulnerable = true, invincibility = true,
    godmode = true, bubble = true,
}

local function HasForceField(character)
    if not character then return false end
    if character:FindFirstChildOfClass("ForceField") then return true end
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("ForceField") then return true end
        if d:IsA("BasePart") and FORCEFIELD_NAMES[d.Name:lower()] and d.Transparency < 1 then
            return true
        end
    end
    return false
end

local function IsVisible(head)
    local localChar = LocalPlayer.Character
    if not localChar then return false end
    local rootPart = localChar:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    rayParams.FilterDescendantsInstances = {localChar}
    local result = workspace:Raycast(rootPart.Position, head.Position - rootPart.Position, rayParams)
    if result then return result.Instance:IsDescendantOf(head.Parent) end
    return false
end

local function GetClosestHead(anyDirection, requireVisible)
    local closest, closestDist, closestPlayer, closestGameChar = nil, math.huge, nil, nil
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end

    local camCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
        if gameChar.Player == LocalPlayer then continue end
        if gameChar.GamePlayer:GetLocalRelationship() ~= "Enemy" then continue end
        local char = gameChar.Character
        if not char or not char.IsAlive then continue end
        if settings.ignoreForcefield and char.Model and HasForceField(char.Model) then continue end
        local model = char.Model
        local head = model:FindFirstChild("Head")
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not head or not humanoid or humanoid.Health <= 0 then continue end

        if requireVisible and not IsVisible(head) then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        local score
        if onScreen then
            score = (Vector2.new(screenPos.X, screenPos.Y) - camCenter).Magnitude
        elseif anyDirection then
            local dist3D = (head.Position - localRoot.Position).Magnitude
            score = 100000 + dist3D
        else
            continue
        end

        if score < closestDist then
            closestDist = score
            closest = head
            closestPlayer = gameChar.Player
            closestGameChar = gameChar
        end
    end
    return closest, closestPlayer, closestGameChar
end

local TRAP_NAME_PATTERNS = {
    "trap", "goop", "curse", "mine", "shock", "slow", "web", "snare",
}

local function isTrapPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local n = string.lower(part.Name)
    for _, pattern in ipairs(TRAP_NAME_PATTERNS) do
        if n:find(pattern) then return true end
    end
    return false
end

local function getTrapAdornee(part)
    local node = part.Parent
    local depth = 0
    while node and node ~= workspace and depth < 6 do
        if node:IsA("Model") then
            local lname = string.lower(node.Name)
            for _, pattern in ipairs(TRAP_NAME_PATTERNS) do
                if lname:find(pattern) then return node end
            end
        end
        node = node.Parent
        depth = depth + 1
    end
    return part
end

local function findTrapsInRange(maxRadius, requireVisible)
    local localChar = LocalPlayer.Character
    if not localChar then return {} end
    local root = localChar:FindFirstChild("HumanoidRootPart")
    if not root then return {} end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = {localChar}

    local parts = workspace:GetPartBoundsInRadius(root.Position, maxRadius, overlapParams)
    local traps = {}
    local added = {}

    for _, part in ipairs(parts) do
        if isTrapPart(part) then
            local adornee = getTrapAdornee(part)
            if not added[adornee] then
                local visible = true
                if requireVisible then
                    local rp = RaycastParams.new()
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    rp.FilterDescendantsInstances = {localChar}
                    local result = workspace:Raycast(root.Position, part.Position - root.Position, rp)
                    visible = result ~= nil and (result.Instance == part or result.Instance:IsDescendantOf(part.Parent))
                end
                if visible then
                    local dist = (part.Position - root.Position).Magnitude
                    local entry = { part = part, adornee = adornee, dist = dist }
                    table.insert(traps, entry)
                    added[adornee] = entry
                end
            end
        end
    end

    table.sort(traps, function(a, b) return a.dist < b.dist end)
    return traps
end

m_CombatClient.OnLocalEvent:Connect(function(combatEvent)
    if not settings.silentAim and not settings.autoShootTraps then return end

    local throwPos = combatEvent.GameAction.Position

    if settings.autoShootTraps then
        local traps = findTrapsInRange(settings.trapShootRange, true)
        if #traps > 0 then
            combatEvent.GameAction.Direction = (traps[1].part.Position - throwPos).Unit
            return
        end
    end

    if settings.silentAim then
        local head = GetClosestHead(true, true)
        if head then
            combatEvent.GameAction.Direction = (head.Position - throwPos).Unit
        end
    end
end)

local useClipHooked = false
local function HookUseClip()
    if useClipHooked then return end
    local upvalues = getupvalues(m_ToolUsageClient.NewToolUsage)
    for i, v in pairs(upvalues) do
        if type(v) == "table" and v.UseClip ~= nil then
            local original_UseClip = v.UseClip
            v.UseClip = function(self)
                if settings.infiniteAmmo then self.Clip = self.Clip + 1 end
                return original_UseClip(self)
            end
            useClipHooked = true; break
        end
    end
end
