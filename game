local logLines = {}
local function addLog(t)
    table.insert(logLines, t)
    logBox.Text = table.concat(logLines, "\n")
end

local function copyAll()
    local t = table.concat(logLines, "\n")
    pcall(function() if setclipboard then setclipboard(t) end end)
    pcall(function() if toclipboard then toclipboard(t) end end)
end

local function getEquippedKnife()
    local upvals = getupvalues(m_BackpackClient.GetToolById)
    for _, v in pairs(upvals) do
        if type(v) == "table" then
            for _, tool in pairs(v) do
                if type(tool) == "table" and tool.Store and tool.Store.FSM then
                    if tool.Setup and type(tool.Setup.ToolBehaviour) == "string"
                       and tool.Setup.ToolBehaviour:lower():find("knife", 1, true) then
                        return tool
                    end
                end
            end
        end
    end
    return nil
end

