    dropdown.Position = UDim2.new(1, -150, 0, 4)
    dropdown.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    dropdown.Text = default or options[1]
    dropdown.TextColor3 = Color3.fromRGB(220, 220, 220)
    dropdown.Font = Enum.Font.Gotham
    dropdown.TextSize = 12
    dropdown.Parent = frame

    local dc = Instance.new("UICorner")
    dc.CornerRadius = UDim.new(0, 4)
    dc.Parent = dropdown

    local listFrame = Instance.new("Frame")
    listFrame.Size = UDim2.new(0, 140, 0, math.min(#options * 28, 200))
    listFrame.Position = UDim2.new(0, 0, 1, 2)
    listFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    listFrame.BorderSizePixel = 0
    listFrame.Visible = false
    listFrame.ZIndex = 10
    listFrame.Parent = dropdown

    local lc = Instance.new("UICorner")
    lc.CornerRadius = UDim.new(0, 4)
    lc.Parent = listFrame

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.CanvasSize = UDim2.new(0, 0, 0, #options * 28)
    scroll.ZIndex = 11
    scroll.Parent = listFrame

    for i, opt in ipairs(options) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.Position = UDim2.new(0, 0, 0, (i-1) * 28)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        btn.BorderSizePixel = 0
        btn.Text = opt
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.ZIndex = 12
        btn.Parent = scroll
        btn.MouseButton1Click:Connect(function()
            dropdown.Text = opt
            listFrame.Visible = false
            if callback then callback(opt) end
        end)
    end

    dropdown.MouseButton1Click:Connect(function()
        listFrame.Visible = not listFrame.Visible
    end)
    return frame
end

