local sf = Instance.new("ScrollingFrame")
sf.Size = UDim2.new(1, -16, 1, -50)
sf.Position = UDim2.new(0, 8, 0, 40)
sf.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
sf.BorderSizePixel = 0
sf.ScrollBarThickness = 6
sf.CanvasSize = UDim2.new(0, 0, 0, 0)
sf.ZIndex = 201
sf.Parent = f

local sfc = Instance.new("UICorner")
sfc.CornerRadius = UDim.new(0, 6)
sfc.Parent = sf

local tb = Instance.new("TextBox")
tb.Size = UDim2.new(1, -16, 0, 8000)
tb.Position = UDim2.new(0, 8, 0, 8)
tb.BackgroundTransparency = 1
tb.Text = "Building..."
tb.TextColor3 = Color3.fromRGB(220, 220, 230)
tb.Font = Enum.Font.Code
tb.TextSize = 11
tb.TextXAlignment = Enum.TextXAlignment.Left
tb.TextYAlignment = Enum.TextYAlignment.Top
tb.MultiLine = true
tb.TextEditable = true
tb.ClearTextOnFocus = false
tb.TextWrapped = false
tb.ZIndex = 202
tb.Parent = sf

local RS_CookieStore = RS:FindFirstChild("CookieStore")
local Assets = RS_CookieStore and RS_CookieStore:FindFirstChild("Assets")
local ItemsFolder = Assets and Assets:FindFirstChild("Items")

if not ItemsFolder then
    title.Text = "ERROR: Assets.Items not found"
    return
end

-- Build the list
local lines = {}
local function add(s)
    table.insert(lines, s)
    tb.Text = table.concat(lines, "\n")
    sf.CanvasSize = UDim2.new(0, 0, 0, #lines * 16 + 40)
end

add("=== MY COOKIE STORE — FULL ITEM CATALOG ===")
add("PlaceId: " .. tostring(game.PlaceId))
add("Grid: 1 square = 1 stud footprint")
add("")

-- Group by collection
local byCollection = {}
local uncategorized = {}

for _, item in ipairs(ItemsFolder:GetChildren()) do
    local itemId = item:GetAttribute("ItemId") or item.Name
    local kind = item:GetAttribute("Kind") or "unknown"
    local collection = item:GetAttribute("Collection") or "Uncategorized"
    local fpW = item:GetAttribute("FootprintW") or 1
    local fpD = item:GetAttribute("FootprintD") or 1

    -- Get height from Hitbox or bounding box
    local height = 0
    local hitbox = item:FindFirstChild("Hitbox")
    if hitbox and hitbox:IsA("BasePart") then
        height = hitbox.Size.Y
    else
        local ok, ext = pcall(function() return item:GetExtentsSize() end)
        if ok and ext then height = ext.Y end
    end

    local entry = {
        name = itemId,
        kind = kind,
        collection = collection,
        w = fpW,
        d = fpD,
        h = height,
    }

    if collection == "Uncategorized" then
        table.insert(uncategorized, entry)
    else
        if not byCollection[collection] then byCollection[collection] = {} end
        table.insert(byCollection[collection], entry)
    end
end

-- Sort helpers
local function sortByName(a, b) return a.name:lower() < b.name:lower() end

-- Output by collection
local collections = {}
for name, _ in pairs(byCollection) do table.insert(collections, name) end
table.sort(collections)

for _, collectionName in ipairs(collections) do
    local items = byCollection[collectionName]
    table.sort(items, sortByName)
    add("")
    add("━━━ " .. collectionName .. " (" .. #items .. " items) ━━━")
    for _, entry in ipairs(items) do
        add(string.format("%-32s | %dW x %dD x %.1fH | %s",
            entry.name, entry.w, entry.d, entry.h, entry.kind))
    end
end

if #uncategorized > 0 then
    table.sort(uncategorized, sortByName)
    add("")
    add("━━━ Uncategorized (" .. #uncategorized .. " items) ━━━")
    for _, entry in ipairs(uncategorized) do
        add(string.format("%-32s | %dW x %dD x %.1fH | %s",
            entry.name, entry.w, entry.d, entry.h, entry.kind))
    end
end

add("")
add("=== END ===")
add("Total items: " .. #ItemsFolder:GetChildren())

local text = table.concat(lines, "\n")
local copied = false
pcall(function() if setclipboard then setclipboard(text); copied = true end end)
if not copied then pcall(function() if toclipboard then toclipboard(text); copied = true end end) end

title.Text = "Done — " .. #lines .. " lines " .. (copied and "| copied ✓" or "| clipboard failed")
copyBtn.MouseButton1Click:Connect(function()
    local t = table.concat(lines, "\n")
    pcall(function() if setclipboard then setclipboard(t) end end)
    pcall(function() if toclipboard then toclipboard(t) end end)
    copyBtn.Text = "✓ Copied"
    task.wait(1.5)
    copyBtn.Text = "📋 Copy"
end)
