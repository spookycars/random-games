local function GetAllTools()
    local tools = {}
    local upvals = getupvalues(m_BackpackClient.GetToolById)
    for i, v in pairs(upvals) do
        if type(v) == "table" then
            for id, tool in pairs(v) do
                if type(tool) == "table" and tool.Store then
                    table.insert(tools, tool)
                end
            end
        end
    end
    return tools
end

local function ResolveWeaponType(tool)
    if not tool.Setup then return nil end
    local behaviour = tool.Setup.ToolBehaviour
    if type(behaviour) ~= "string" then return nil end
    local b = behaviour:lower()
    if b:find("knife", 1, true) or b:find("melee", 1, true) or b:find("blade", 1, true) then
        return "knife"
    end
    if b:find("gun", 1, true) or b:find("firearm", 1, true) or b:find("pistol", 1, true)
       or b:find("rifle", 1, true) or b:find("shotgun", 1, true) or b:find("weapon", 1, true) then
        return "gun"
    end
    return nil
end

-- ============ FIRE LOGIC — charge-aware, no artificial cooldown ============
-- Sharp knife FSM: Charge / ChargeHold / Equip / Fire / Idle / Preview / Throw
-- Sequence: ChargeHold --Set(Fire)--> Fire --(auto)--> Charge --Set(Throw)--> Throw
-- The FSM's own animation durations act as the natural rate limiter
-- No tick() cooldown needed — the state machine handles pacing

local lastKnifeThrowAt = 0

local function FireKnife(tool)
    local fsm = tool.Store.FSM
    if not fsm then return false end
    local state = tostring(fsm.State or "")

    -- Skip states where the FSM is busy
    if state == "Fire" or state == "Throw" or state == "Equip" or state == "Preview" then
        return false
    end

    if state == "ChargeHold" then
        -- Begin the release sequence — Fire will auto-transition to Charge
        if type(fsm.Set) == "function" then
            local ok = pcall(fsm.Set, fsm, "Fire")
            if ok then return true end
        end
        return false
    end

    if state == "Charge" then
        -- Fully charged, throw now
        local ok = false
        if type(fsm.ForceSetState) == "function" then
            ok = pcall(fsm.ForceSetState, fsm, "Throw")
        elseif type(fsm.Set) == "function" then
            ok = pcall(fsm.Set, fsm, "Throw")
        end
        return ok
    end

    return false
end

local GUN_VALID = {
    Fire = true, Idle = true, Reload = true,
    Equip = true, Preview = true,
}

local function FireGun(tool)
    local fsm = tool.Store.FSM
    if not fsm then return false end
    local state = tostring(fsm.State or "")

    if state == "Reload" then
        if settings.autoReload and type(fsm.Set) == "function" then
            pcall(fsm.Set, fsm, "Idle")
            return true
        end
        return false
    end

    if state == "Fire" or state == "Throw" then return false end
    if not GUN_VALID[state] then return false end

    if type(fsm.Set) == "function" then
        return pcall(fsm.Set, fsm, "Fire")
    end
    return false
end

local function TryFire()
    for _, tool in ipairs(GetAllTools()) do
        if tool.Equipped and tool.Store and tool.Store.FSM then
            local wType = ResolveWeaponType(tool)
            if wType == "knife" then FireKnife(tool)
            elseif wType == "gun" then FireGun(tool) end
        end
    end
end

-- ============ CROSSHAIR CHECK with WALL RAYCAST ============
local CROSSHAIR_RADIUS = 60

local function IsCrosshairOnEnemy()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local localChar = LocalPlayer.Character
    if not localChar then return false end

    for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
        if gameChar.Player == LocalPlayer then continue end
        if gameChar.GamePlayer:GetLocalRelationship() ~= "Enemy" then continue end
        local char = gameChar.Character
        if not char or not char.IsAlive or not char.Model then continue end
        local head = char.Model:FindFirstChild("Head")
        if not head then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist > CROSSHAIR_RADIUS then continue end

        -- WALL CHECK: raycast from camera to head, excluding own char + target
        local origin = Camera.CFrame.Position
        local direction = head.Position - origin
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {localChar, char.Model}
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local result = workspace:Raycast(origin, direction, params)

        -- If raycast returns nil, nothing between us and the target → clear shot
        -- If raycast returns something, it's a wall → blocked
        if result == nil then
            return true
        end
    end
    return false
end

