-- ---------- HOOK 1: __namecall (method calls) ----------
local hooked = false
local hookErr = nil

pcall(function()
    local mt = getrawmetatable(game)
    if not mt then error("no metatable") end
    local oldNamecall = mt.__namecall
    if not oldNamecall then error("no __namecall") end

    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if typeof(method) == "string" then
            local lower = method:lower()
            if lower:find("kick", 1, true) or lower:find("ban", 1, true) then
                local args = {...}
                recordEvent(method, self, #args > 0 and tostring(args[1]) or "")
                return nil -- block the kick
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
    hooked = true
end)

if not hooked then
    if tb then
        tb.Text = "❌ Could not hook __namecall\n\n" .. tostring(hookErr) ..
            "\n\nYour executor may block metatable hooks. Kick cannot be intercepted."
    end
    return
end

-- ---------- HOOK 2: Watch known kick remotes ----------
-- Some games use a RemoteEvent named something specific
pcall(function()
    local RS = game:GetService("ReplicatedStorage")
    local keywords = {"kick", "ban", "detect", "flag", "cheat", "exploit"}
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local nameLower = obj.Name:lower()
            for _, kw in ipairs(keywords) do
                if nameLower:find(kw, 1, true) then
                    -- Note remote names that could be kick-related
                    if tb then
                        local cur = tb.Text
                        tb.Text = cur .. "\n[NOTE] Suspicious remote found: " .. obj:GetFullName()
                    end
                    break
                end
            end
        end
    end
end)

