local espData = {}

local function destroyESP(gameChar)
    local data = espData[gameChar]
    if not data then return end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    espData[gameChar] = nil
end

local function ensureESP(gameChar)
    if espData[gameChar] then return espData[gameChar] end
    local data = { head = nil, model = nil }

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SharpESP_" .. (gameChar.Player and gameChar.Player.Name or "unknown")
    billboard.Size = UDim2.new(0, 200, 0, 28)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = math.huge
    billboard.Enabled = false
    billboard.Parent = espFolder
    data.billboard = billboard

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Text = ""
    label.Parent = billboard
    data.label = label

    local highlight = Instance.new("Highlight")
    highlight.Name = "SharpCham_" .. (gameChar.Player and gameChar.Player.Name or "unknown")
    highlight.FillTransparency = 0.55
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = chamFolder
    data.highlight = highlight

    local char = gameChar.Character
    if char and char.Model and char.Model.Parent then
        local head = char.Model:FindFirstChild("Head")
        if head then
            billboard.Adornee = head
            data.head = head
        end
        highlight.Adornee = char.Model
        data.model = char.Model
    end

    espData[gameChar] = data
    return data
end

