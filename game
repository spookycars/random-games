RunService.Heartbeat:Connect(function()
    if not settings.espEnabled then
        for player, _ in pairs(espState) do clearPlayerState(player) end
        clearTargetHighlight()
        return
    end

    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then
            clearPlayerState(player)
            continue
        end

        local model, gameChar = getPlayerModel(player)
        local head, hum
        if model then
            head = model:FindFirstChild("Head")
            hum = model:FindFirstChildOfClass("Humanoid")
        end

        if not model or not head or not hum or hum.Health <= 0 then
            clearPlayerState(player)
            continue
        end

        local ok, rel = pcall(function()
            if gameChar and gameChar.GamePlayer then
                return gameChar.GamePlayer:GetLocalRelationship()
            end
            return nil
        end)
        local isEnemy
        if ok and rel == "Enemy" then isEnemy = true
        elseif ok and rel ~= nil then isEnemy = false
        else
            local myTeam = LocalPlayer.TeamColor
            local theirTeam = player.TeamColor
            if myTeam and theirTeam then isEnemy = (theirTeam ~= myTeam)
            else isEnemy = true end
        end

        local shouldShow = true
        if settings.espEnemyOnly and not isEnemy then shouldShow = false end
        if settings.espTeamOnly and isEnemy then shouldShow = false end

        local dist = 0
        if localRoot and model:FindFirstChild("HumanoidRootPart") then
            dist = (model.HumanoidRootPart.Position - localRoot.Position).Magnitude
        end
        if dist > settings.espMaxDistance then shouldShow = false end

        if not shouldShow then
            clearPlayerState(player)
            continue
        end

        local color = isEnemy and settings.espEnemyColor or settings.espTeamColor

        local state = espState[player]
        if not state then
            state = {
                billboard = nil, label = nil, highlight = nil,
                highlightModel = nil,
                partHook = nil, partHookModel = nil,
                forceRecreate = false, recreatePending = false,
            }
            espState[player] = state
        end

        if state.forceRecreate and not state.recreatePending then
            state.recreatePending = true
            task.delay(0.2, function()
                local s = espState[player]
                if s and s.highlight and s.highlightModel == model then
                    pcall(function() s.highlight:Destroy() end)
                    s.highlight = createHighlightFor(player, model, color)
                end
                if s then
                    s.forceRecreate = false
                    s.recreatePending = false
                end
            end)
        end

        local needsCreate = (not state.highlight)
            or (not state.highlight.Parent)
            or (state.highlightModel ~= model)

        if needsCreate then
            if state.highlight then pcall(function() state.highlight:Destroy() end) end
            state.highlight = createHighlightFor(player, model, color)
            state.highlightModel = model

            if state.partHook then pcall(function() state.partHook:Disconnect() end) end
            state.partHookModel = model
            state.partHook = model.DescendantAdded:Connect(function(desc)
                if desc:IsA("BasePart") then
                    local s = espState[player]
                    if s and s.highlight then
                        s.forceRecreate = true
                    end
                end
            end)
        else
            state.highlight.FillColor = color
            state.highlight.OutlineColor = color
        end

        if state.highlight then
            state.highlight.Enabled = settings.espChams
        end

        local needsBb = (not state.billboard)
            or (not state.billboard.Parent)
            or (state.billboard.Adornee ~= head)

        if needsBb then
            if state.billboard then pcall(function() state.billboard:Destroy() end) end
            state.billboard, state.label = createBillboardFor(player, head, color)
        else
            state.label.TextColor3 = color
        end

        if state.label then
            local parts = {}
            if settings.espNames then table.insert(parts, player.Name) end
            if settings.espDistance then table.insert(parts, math.floor(dist) .. "m") end
            if settings.espHealth then
                table.insert(parts, math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "hp")
            end
            state.label.Text = table.concat(parts, " | ")
        end
    end

    if settings.targetHighlight then
        local _, _, gameChar = GetClosestTarget(true, false, settings.silentAimPart)
        if gameChar and gameChar.Character and gameChar.Character.Model then
            applyTargetHighlight(gameChar.Character.Model)
        else
            clearTargetHighlight()
        end
    else
        clearTargetHighlight()
    end
end)

