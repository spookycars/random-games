local function copyText(text)
    local ok = false
    pcall(function() if setclipboard then setclipboard(text); ok = true end end)
    if not ok then pcall(function() if toclipboard then toclipboard(text); ok = true end end) end
    return ok
end

-- Suspicious keywords
local KEYWORDS = {
    "anti", "cheat", "hack", "exploit", "detect", "kick", "ban",
    "flag", "monitor", "watch", "report", "guard", "verify",
    "check", "scan", "protect", "security", "integrity", "validate",
    "sus", "violat", "punish"
}

local function matches(name)
    local lower = tostring(name):lower()
    for _, kw in ipairs(KEYWORDS) do
        if lower:find(kw, 1, true) then return kw end
    end
    return nil
end

-- Try to read source
local function tryReadSource(script)
    -- Method 1: getscriptbytecode
    if getscriptbytecode then
        local ok, bc = pcall(getscriptbytecode, script)
        if ok and bc and type(bc) == "string" and #bc > 0 then
            return "bytecode:" .. #bc .. " bytes", bc
        end
    end
    -- Method 2: debug.getsource
    if debug and debug.getsource then
        local ok, src = pcall(debug.getsource, script)
        if ok and src and type(src) == "string" then
            return "source:" .. #src .. " chars", src
        end
    end
    -- Method 3: dumpstring (common in some executors)
    if dumpstring then
        local ok, str = pcall(dumpstring, script)
        if ok and str and type(str) == "string" then
            return "dump:" .. #str, str
        end
    end
    return nil, nil
end

