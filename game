-- SHARP module diagnostic
local RS = game:GetService("ReplicatedStorage")
local function check(path)
    local parts = path:split(".")
    local node = RS
    for _, p in ipairs(parts) do
        node = node and node:FindFirstChild(p)
    end
    return node ~= nil
end
print("=== SHARP MODULE CHECK ===")
for _, m in ipairs({
    "Client.Controllers.GameCharacterController",
    "Client.Madwork.CombatClient",
    "Client.Madwork.BackpackClient",
    "Client.Madwork.ToolUsageClient",
    "Shared.Madwork.MadFSM",
    "Shared.Madwork.MadworkCaster",
}) do
    print((check(m) and "[OK]   " or "[FAIL] ") .. m)
end
