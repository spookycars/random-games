        pcall(updateTrapBarriers)
    end
end)

local chargeStartedAt = {}
local lastKnifeThrow = 0
local lastGunShot = 0

local function ResetCharges()
    for k in pairs(chargeStartedAt) do chargeStartedAt[k] = nil end
end

local function FireKnife(tool)
    local fsm = tool.Store.FSM
    if not fsm then return false end
    local state = tostring(fsm.State or "")

    if state == "Fire" or state == "Throw" or state == "Equip" or state == "Preview" then
        return false
    end
    if tick() - lastKnifeThrow < settings.knifeTriggerDelay then return false end

    if state == "Charge" then
        chargeStartedAt[tool] = nil
        if type(fsm.Set) == "function" then
            local ok = pcall(fsm.Set, fsm, "Throw")
            if ok then lastKnifeThrow = tick() end
            return ok
        end
        return false
    end

    if state == "ChargeHold" or state == "Idle" then
        if not chargeStartedAt[tool] then
            chargeStartedAt[tool] = tick()
            if state == "Idle" and type(fsm.Set) == "function" then
                pcall(fsm.Set, fsm, "ChargeHold")
            end
            return false
        end
        if tick() - chargeStartedAt[tool] < settings.chargeTime then return false end
        chargeStartedAt[tool] = nil
        if type(fsm.Set) == "function" then
            local ok = pcall(fsm.Set, fsm, "Throw")
            if ok then lastKnifeThrow = tick() end
            return ok
        end
        return false
    end
    return false
end

local function FireGun(tool)
    local fsm = tool.Store.FSM
    if not fsm then return false end
    local state = tostring(fsm.State or "")

    if state == "Reload" then
        if settings.autoReload and type(fsm.Set) == "function" then
            pcall(fsm.Set, fsm, "Idle")
            return true
        end
        return false
    end
    if state == "Fire" or state == "Throw" then return false end
    if tick() - lastGunShot < 0.1 then return false end

    if type(fsm.Set) == "function" then
        local ok = pcall(fsm.Set, fsm, "Fire")
        if ok then lastGunShot = tick() end
        return ok
    end
    return false
end

local function TryFire()
    for _, tool in ipairs(GetAllTools()) do
        if tool.Equipped and tool.Store and tool.Store.FSM then
            local wType = ResolveWeaponType(tool)
            if wType == "knife" then FireKnife(tool)
            elseif wType == "gun" then FireGun(tool) end
        end
    end
end

local CROSSHAIR_RADIUS = 60
local function IsCrosshairOnEnemy()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local localChar = LocalPlayer.Character
    if not localChar then return false end
    for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
        if gameChar.Player == LocalPlayer then continue end
        if gameChar.GamePlayer:GetLocalRelationship() ~= "Enemy" then continue end
        local char = gameChar.Character
        if not char or not char.IsAlive or not char.Model then continue end
        if settings.ignoreForcefield and HasForceField(char.Model) then continue end
        local head = char.Model:FindFirstChild("Head")
        if not head then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist > CROSSHAIR_RADIUS then continue end
        local origin = Camera.CFrame.Position
        local direction = head.Position - origin
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {localChar, char.Model}
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        if workspace:Raycast(origin, direction, params) == nil then return true end
    end
    return false
end

local CHARGE_GRACE_PERIOD = 0.3
local lastValidTargetTime = 0

task.spawn(function()
    while true do
        task.wait(0.05)
        if settings.triggerBot then
            local shouldFire = false
            if settings.triggerBotMode == "Crosshair" then
                shouldFire = IsCrosshairOnEnemy()
            elseif settings.triggerBotMode == "Aimbot" then
                shouldFire = settings.aimbot.enabled and targetLocked ~= nil
