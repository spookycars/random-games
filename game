-- ---------- CAPTURE LOGIC ----------
local captured = {}
local capturedCount = 0

local function recordEvent(methodName, target, extra)
    capturedCount = capturedCount + 1
    local trace = debug.traceback("", 2)
    local timeStr = "?"
    pcall(function() timeStr = tostring(os.time()) end)
    if timeStr == "?" then pcall(function() timeStr = tostring(math.floor(tick())) end) end

    local entry = string.format(
        "══════ CAPTURE #%d ══════\n" ..
        "Method: %s\n" ..
        "Target: %s\n" ..
        "Time: %s\n" ..
        "Extra: %s\n\n" ..
        "STACK TRACE:\n%s\n",
        capturedCount, tostring(methodName), tostring(target), timeStr,
        tostring(extra or "none"), trace
    )
    table.insert(captured, entry)

    local fullText = table.concat(captured, "\n")
    local copied = copyText(fullText)

    if tb then
        tb.Text = fullText
        statusLabel.Text = string.format("⚠ CAPTURE #%d (%s) | %s",
            capturedCount, tostring(methodName),
            copied and "copied to clipboard" or "COPY MANUALLY")
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        titleBar.Text = "🕵 Anti-Cheat Finder — CAPTURED #" .. capturedCount
        titleBar.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

