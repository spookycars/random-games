    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 4)
    padding.PaddingBottom = UDim.new(0, 12)
    padding.Parent = page

    local function updateCanvas()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 24)
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
    task.defer(updateCanvas)

    local tab = { Button = tabBtn, Page = page, Name = name }
    table.insert(self.Tabs, tab)

    tabBtn.Activated:Connect(function()
        for _, t2 in ipairs(self.Tabs) do
            t2.Page.Visible = false
            t2.Button.BackgroundColor3 = Color3.fromRGB(28,28,36)
            t2.Button.TextColor3 = Color3.fromRGB(200,200,200)
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(180,40,40)
        tabBtn.TextColor3 = Color3.new(1,1,1)
        updateCanvas()
    end)

    if #self.Tabs == 1 then
        page.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(180,40,40)
        tabBtn.TextColor3 = Color3.new(1,1,1)
    end
    return page
end

