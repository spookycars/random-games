-- ===================== ESP =====================
local espObjects = {}

local function GetCharColor(gameChar)
    local rel = gameChar.GamePlayer:GetLocalRelationship()
    return rel == "Enemy" and settings.espEnemyColor or settings.espTeamColor
end

local function ShouldShowESP(gameChar)
    if not settings.espEnabled then return false end
    local ok, rel = pcall(function() return gameChar.GamePlayer:GetLocalRelationship() end)
    if ok and rel then
        if settings.espEnemyOnly and rel ~= "Enemy" then return false end
        if settings.espTeamOnly and rel ~= "Friendly" then return false end
    end
    local localChar = LocalPlayer.Character
    local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if localHum and localHum.Health > 0 and localRoot then
        local enemyRoot = gameChar.Character and gameChar.Character.RootPart
        if enemyRoot then
            local dist = (enemyRoot.Position - localRoot.Position).Magnitude
            if dist > settings.espMaxDistance then return false end
        end
    end
    return true
end

local function CreateESPForChar(gameChar)
    if gameChar.Player == LocalPlayer then return end
    if espObjects[gameChar] then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SharpESP"
    billboard.Size = UDim2.new(0, 220, 0, 36)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = math.huge
    billboard.Enabled = false
    billboard.Parent = PG
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = Color3.new(1,1,1)
    label.Text = ""
    label.Parent = billboard
    local highlight = Instance.new("Highlight")
    highlight.Name = "SharpChams"
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.new(1,1,1)
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = PG
    espObjects[gameChar] = { billboard = billboard, label = label, highlight = highlight, lastModel = nil }
end

local function RemoveESPForChar(gameChar)
    local esp = espObjects[gameChar]
    if not esp then return end
    if esp.billboard then esp.billboard:Destroy() end
    if esp.highlight then esp.highlight:Destroy() end
    espObjects[gameChar] = nil
end

for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
    CreateESPForChar(gameChar)
end
m_GameCharacterController.GameCharacterAdded:Connect(CreateESPForChar)

task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            local current = m_GameCharacterController.GetGameCharacters()
            local currentSet = {}
            for _, gc in ipairs(current) do currentSet[gc] = true end
            for gc in pairs(espObjects) do
                if not currentSet[gc] then RemoveESPForChar(gc) end
            end
            for _, gc in ipairs(current) do
                if not espObjects[gc] then CreateESPForChar(gc) end
            end
        end)
    end
end)

local currentHighlight, lastTarget = nil, nil
local function ClearHighlight()
    if currentHighlight then currentHighlight:Destroy(); currentHighlight = nil end
    lastTarget = nil
end
local function ApplyHighlight(model)
    if lastTarget == model then return end
    ClearHighlight()
    local h = Instance.new("Highlight")
    h.FillColor = Color3.fromRGB(255,50,50)
    h.OutlineColor = Color3.new(1,1,1)
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.Adornee = model
    h.Parent = PG
    currentHighlight = h
    lastTarget = model
end

local original_NewCaster = m_MadworkCaster.NewCaster
m_MadworkCaster.NewCaster = function(params)
    local caster = original_NewCaster(params)
    if settings.knifeTracers and Drawing then
        local line = Drawing.new("Line")
        line.Thickness = 2
        line.Color = settings.knifeTracerColor
        line.Transparency = 0.3
        line.Visible = false
        local startPos = params.Position
        caster:OnUpdate(function()
            if not settings.knifeTracers then line.Visible = false return end
            local s, on1 = Camera:WorldToViewportPoint(startPos)
            local e, on2 = Camera:WorldToViewportPoint(caster.Position)
            line.From = Vector2.new(s.X, s.Y)
            line.To = Vector2.new(e.X, e.Y)
            line.Visible = on1 and on2
        end)
        caster:OnSolve(function() line:Remove() end)
    end
    return caster
end

RunService.Heartbeat:Connect(function()
    local localChar = LocalPlayer.Character
    local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local localAlive = localHum and localHum.Health > 0

    for gameChar, esp in pairs(espObjects) do
        if not gameChar.Player or not gameChar.Player.Parent then
            RemoveESPForChar(gameChar)
            continue
        end
        local char = gameChar.Character
        if not ShouldShowESP(gameChar) or not char or not char.IsAlive then
            esp.billboard.Enabled = false
            esp.highlight.Enabled = false
            continue
        end
        local model = char.Model
        local head = model and model:FindFirstChild("Head")
        if not head then
            esp.billboard.Enabled = false
            esp.highlight.Enabled = false
            continue
        end
        if esp.lastModel ~= model then
            esp.billboard.Adornee = head
            esp.highlight.Adornee = model
            esp.lastModel = model
        end
        local color = GetCharColor(gameChar)
        local hp = gameChar.DamageReceiver and gameChar.DamageReceiver.Health or 0
        local hpMax = gameChar.DamageReceiver and gameChar.DamageReceiver.MaxHealth or 100
        local dist = 0
        if localAlive and localRoot and char.RootPart then
            dist = math.floor((char.RootPart.Position - localRoot.Position).Magnitude)
        end
        local parts = {}
        if settings.espNames then table.insert(parts, gameChar.Player.Name) end
        if settings.espDistance then table.insert(parts, localAlive and (dist .. "m") or "?m") end
        if settings.espHealth then table.insert(parts, math.floor(hp) .. "/" .. math.floor(hpMax) .. "hp") end
        esp.label.Text = table.concat(parts, " | ")
        esp.label.TextColor3 = color
        esp.billboard.Enabled = true
        if settings.espChams then
            esp.highlight.FillColor = color
            esp.highlight.OutlineColor = color
            esp.highlight.Enabled = true
        else
            esp.highlight.Enabled = false
        end
    end

    if settings.targetHighlight then
        local head, _, gameChar = GetClosestHead()
        if gameChar and gameChar.Character and gameChar.Character.IsAlive then
            ApplyHighlight(gameChar.Character.Model)
        else ClearHighlight() end
    else ClearHighlight() end
end)

