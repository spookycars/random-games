-- ---------- UTILS ----------
local function copyText(text)
    local ok = false
    pcall(function() if setclipboard then setclipboard(text); ok = true end end)
    if not ok then pcall(function() if toclipboard then toclipboard(text); ok = true end end) end
    if not ok then pcall(function() if writefile then writefile("kick_trace.txt", text); ok = "file" end end) end
    return ok
end

local function clearUI()
