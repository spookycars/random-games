    label.Parent = frame

    local hexInput = Instance.new("TextBox")
    hexInput.Size = UDim2.new(0, 85, 1, -8)
    hexInput.Position = UDim2.new(1, -130, 0, 4)
    hexInput.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    hexInput.BorderSizePixel = 0
    hexInput.Text = string.format("%02X%02X%02X",
        math.floor(default.R * 255), math.floor(default.G * 255), math.floor(default.B * 255))
    hexInput.TextColor3 = Color3.fromRGB(220, 220, 220)
    hexInput.Font = Enum.Font.Gotham
    hexInput.TextSize = 12
    hexInput.ClearTextOnFocus = false
    hexInput.Parent = frame

    local hc = Instance.new("UICorner")
    hc.CornerRadius = UDim.new(0, 4)
    hc.Parent = hexInput

    local swatch = Instance.new("Frame")
    swatch.Size = UDim2.new(0, 30, 1, -8)
    swatch.Position = UDim2.new(1, -42, 0, 4)
    swatch.BackgroundColor3 = default
    swatch.BorderSizePixel = 0
    swatch.Parent = frame

    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 4)
    sc.Parent = swatch

    local current = default
    hexInput.FocusLost:Connect(function()
        local hex = hexInput.Text:gsub("#", ""):upper()
        if #hex == 6 and hex:match("^%x+$") then
            current = Color3.fromRGB(
                tonumber(hex:sub(1, 2), 16),
                tonumber(hex:sub(3, 4), 16),
                tonumber(hex:sub(5, 6), 16))
            swatch.BackgroundColor3 = current
            if callback then callback(current) end
        else
            hexInput.Text = string.format("%02X%02X%02X",
                math.floor(current.R * 255), math.floor(current.G * 255), math.floor(current.B * 255))
        end
    end)
    return frame
end

function Library:CreateDropdown(parent, text, options, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 36)
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
