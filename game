-- ============ SECTION 1: PLAYERSCRIPTS ============
add("══════ PLAYERSCRIPTS (client-owned scripts) ══════")
if PS then
    local count = 0
    for _, obj in ipairs(PS:GetDescendants()) do
        if obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script") then
            count = count + 1
            local kw = matches(obj.Name)
            local flag = kw and ("[⚠" .. kw:upper() .. "]") or "[.]"
            add(string.format("%s %s [%s] path=%s",
                flag, obj.Name, obj.ClassName, obj:GetFullName()))

            -- Try reading suspicious ones only (to save time/rate)
            if kw then
                local mode, src = tryReadSource(obj)
                if mode then
                    add("     SOURCE: " .. mode)
                    -- First 500 chars of source if readable
                    if src and type(src) == "string" then
                        local preview = src:sub(1, 500):gsub("\n", " ")
                        add("     PREVIEW: " .. preview)
                    end
                else
                    add("     SOURCE: [protected/unreadable]")
                end
            end
        end
    end
    add("Total scripts in PlayerScripts: " .. count)
else
    add("PlayerScripts not found")
end
add("")

-- ============ SECTION 2: REPLICATEDSTORAGE SCRIPT-LIKE ============
add("══════ REPLICATEDSTORAGE — scripts and folders ══════")
local rsScripts = 0
for _, obj in ipairs(RS:GetDescendants()) do
    if obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script") then
        rsScripts = rsScripts + 1
        local kw = matches(obj.Name)
        if kw then
            add(string.format("[⚠%s] %s [%s] path=%s",
                kw:upper(), obj.Name, obj.ClassName, obj:GetFullName()))
            local mode, src = tryReadSource(obj)
            if mode then
                add("     SOURCE: " .. mode)
                if src then
                    local preview = src:sub(1, 500):gsub("\n", " ")
                    add("     PREVIEW: " .. preview)
                end
            else
                add("     SOURCE: [protected/unreadable]")
            end
        end
    end
end
