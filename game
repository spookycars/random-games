-- Helper: safe attribute dump
local function attrStr(obj)
    local ok, attrs = pcall(function() return obj:GetAttributes() end)
    if not ok or not attrs then return "" end
    local parts = {}
    for k, v in pairs(attrs) do
        table.insert(parts, k .. "=" .. tostring(v))
    end
    if #parts == 0 then return "" end
    return " {" .. table.concat(parts, ", ") .. "}"
end

-- Helper: safe size
local function getSize(obj)
    if obj:IsA("BasePart") then
        return string.format("%.2f x %.2f x %.2f", obj.Size.X, obj.Size.Y, obj.Size.Z)
    end
    if obj:IsA("Model") then
        local ok, ext = pcall(function() return obj:GetExtentsSize() end)
        if ok and ext then
            return string.format("%.2f x %.2f x %.2f", ext.X, ext.Y, ext.Z)
        end
    end
    return nil
end

-- ===== SECTION 1: Try Shared.Build.Grid for grid size info =====
add("--- Shared.Build.Grid ---")
local shared = RS:FindFirstChild("CookieStore")
shared = shared and shared:FindFirstChild("Shared")
local build = shared and shared:FindFirstChild("Build")
local gridModule = build and build:FindFirstChild("Grid")

if gridModule then
    local ok, result = pcall(require, gridModule)
    if ok then
        if type(result) == "table" then
            for k, v in pairs(result) do
                if type(v) ~= "table" and type(v) ~= "function" then
                    add("  " .. tostring(k) .. " = " .. tostring(v) .. " (" .. type(v) .. ")")
                elseif type(v) == "table" then
                    local sub = {}
                    for sk, sv in pairs(v) do
                        if #sub >= 5 then break end
                        table.insert(sub, tostring(sk) .. "=" .. tostring(sv))
                    end
                    add("  " .. tostring(k) .. " = {" .. table.concat(sub, ", ") .. "}")
                end
            end
        else
            add("  grid = " .. tostring(result) .. " (" .. type(result) .. ")")
        end
    else
        add("  ✗ require failed: " .. tostring(result))
    end
else
    add("  ✗ not found")
end
add("")

-- ===== SECTION 2: Assets.Items =====
add("--- Assets.Items ---")
local assets = RS:FindFirstChild("CookieStore")
assets = assets and assets:FindFirstChild("Assets")
local itemsFolder = assets and assets:FindFirstChild("Items")

if itemsFolder then
    local items = itemsFolder:GetChildren()
    add("Total items: " .. #items)
    add("")

    -- Sample structure of first 3 items
    add("--- SAMPLE: first 3 items structure ---")
    for i = 1, math.min(3, #items) do
        local item = items[i]
        add(string.format("%d. %s [%s]", i, item.Name, item.ClassName))
        add("   size: " .. (getSize(item) or "?"))
        add("   attrs: " .. (attrStr(item) ~= "" and attrStr(item) or "(none)"))
        for _, sub in ipairs(item:GetChildren()) do
            local sz = ""
            if sub:IsA("BasePart") then
                sz = string.format(" | size=%.2f,%.2f,%.2f", sub.Size.X, sub.Size.Y, sub.Size.Z)
            end
            add(string.format("   └─ %s [%s]%s%s", sub.Name, sub.ClassName, sz, attrStr(sub)))
        end
        add("")
    end

    -- Full item list
    add("--- ALL ITEMS ---")
    local sorted = {}
    for _, it in ipairs(items) do table.insert(sorted, it) end
    table.sort(sorted, function(a, b) return a.Name:lower() < b.Name:lower() end)

    for _, item in ipairs(sorted) do
        local sz = getSize(item) or "?"
        local at = attrStr(item)
        add(string.format("%-35s | %s | size: %s%s",
            item.Name, item.ClassName, sz, at))
    end
else
    add("✗ Assets.Items not found")
end
add("")

-- ===== SECTION 3: Shared.Items module (top-level keys only) =====
add("--- Shared.Items module ---")
local itemsModule = shared and shared:FindFirstChild("Items")

if itemsModule then
    local ok, result = pcall(require, itemsModule)
    if ok and type(result) == "table" then
        local count = 0
        for _ in pairs(result) do count = count + 1 end
        add("Top-level keys: " .. count)
        add("")

        local shown = 0
        for k, v in pairs(result) do
            shown = shown + 1
            if shown > 10 then
                add("... (showing first 10)")
                break
            end
            add(string.format("[%s] = %s", tostring(k), type(v)))
            if type(v) == "table" then
                local sub = {}
                local subCount = 0
                for sk, sv in pairs(v) do
                    subCount = subCount + 1
                    if #sub < 12 then
                        local svStr = type(sv) == "table" and "<table>" or tostring(sv)
                        table.insert(sub, tostring(sk) .. "=" .. svStr)
                    end
                end
                add("   subkeys (" .. subCount .. "): " .. table.concat(sub, ", "))
            end
        end
    else
        add("✗ require failed: " .. tostring(result))
    end
else
    add("✗ Shared.Items not found")
end
add("")

