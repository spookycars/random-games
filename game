    l.Size = UDim2.new(1,-160,1,0); l.Position = UDim2.new(0,12,0,0)
    l.BackgroundTransparency = 1; l.Text = text
    l.TextColor3 = Color3.fromRGB(220,220,220); l.Font = Enum.Font.Gotham
    l.TextSize = 13; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f

    local dd = Instance.new("TextButton")
    dd.Size = UDim2.new(0,140,1,-8); dd.Position = UDim2.new(1,-150,0,4)
    dd.BackgroundColor3 = Color3.fromRGB(40,40,50)
    dd.Text = default or options[1]
    dd.TextColor3 = Color3.fromRGB(220,220,220); dd.Font = Enum.Font.Gotham
    dd.TextSize = 12; dd.Parent = f
    local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(0,4); dc.Parent = dd

    -- IMPORTANT: parent list to Main frame (NOT the ScrollingFrame) to escape clipping
    local lf = Instance.new("Frame")
    lf.Size = UDim2.new(0,140,0,math.min(#options*28,200))
    lf.BackgroundColor3 = Color3.fromRGB(40,40,50)
    lf.BorderSizePixel = 0
    lf.Visible = false
    lf.ZIndex = 10000
    lf.Parent = self.Main
    local lc = Instance.new("UICorner"); lc.CornerRadius = UDim.new(0,4); lc.Parent = lf

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,0); scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3; scroll.CanvasSize = UDim2.new(0,0,0,#options*28)
    scroll.ZIndex = 10001; scroll.Parent = lf

    for i, opt in ipairs(options) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,0,0,28); btn.Position = UDim2.new(0,0,0,(i-1)*28)
        btn.BackgroundColor3 = Color3.fromRGB(50,50,60); btn.BorderSizePixel = 0
        btn.Text = opt; btn.TextColor3 = Color3.fromRGB(220,220,220)
        btn.Font = Enum.Font.Gotham; btn.TextSize = 12
        btn.ZIndex = 10002; btn.Parent = scroll
        btn.Activated:Connect(function()
            dd.Text = opt; lf.Visible = false
            if callback then callback(opt) end
        end)
    end

    local function updateListPos()
        local ddAbs = dd.AbsolutePosition
        local ddAbsSize = dd.AbsoluteSize
        local mainAbs = self.Main.AbsolutePosition
        lf.Position = UDim2.new(0, ddAbs.X - mainAbs.X, 0, ddAbs.Y - mainAbs.Y + ddAbsSize.Y + 2)
    end

    dd.Activated:Connect(function()
        if lf.Visible then
            lf.Visible = false
        else
            -- hide other dropdowns so only one is open at a time
            for _, entry in ipairs(self.OpenDropdowns) do
                if entry.frame ~= lf then pcall(function() entry.hide() end) end
            end
            updateListPos()
            lf.Visible = true
        end
    end)

    -- register so tab switch / menu close can hide it
    table.insert(self.OpenDropdowns, {
        frame = lf,
        hide = function() lf.Visible = false end,
    })

    return f
end

function Library:CreateButton(parent, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-10,0,34); b.BackgroundColor3 = Color3.fromRGB(180,40,40)
    b.Text = text; b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold; b.TextSize = 13; b.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,6); c.Parent = b
    b.Activated:Connect(function() if callback then callback() end end)
    return b
end

