local function findEquippedKnife()
    for _, tool in ipairs(GetAllTools()) do
        if tool.Equipped and IsKnifeTool(tool) then
            return tool
        end
    end
    return nil
end

-- Test 1: FSM Set
mkBtn("Test 1: fsm:Set('Throw')", 46, Color3.fromRGB(60, 120, 200), function()
    local tool = findEquippedKnife()
    if not tool then
        setLog("❌ No knife equipped.")
        return
    end
    local fsm = tool.Store and tool.Store.FSM
    if not fsm then
        setLog("❌ Knife has no FSM.")
        return
    end
    local methods = {}
    if type(fsm.Set) == "function" then table.insert(methods, "Set") end
    if type(fsm.SetState) == "function" then table.insert(methods, "SetState") end
    if type(fsm.ChangeState) == "function" then table.insert(methods, "ChangeState") end
    if type(fsm.ForceSetState) == "function" then table.insert(methods, "ForceSetState") end
    if type(fsm.HandleEvent) == "function" then table.insert(methods, "HandleEvent") end
    
    local ok, err = pcall(function()
        if type(fsm.Set) == "function" then fsm:Set("Throw")
        elseif type(fsm.ForceSetState) == "function" then fsm:ForceSetState("Throw")
        elseif type(fsm.HandleEvent) == "function" then fsm:HandleEvent("Throw")
        elseif type(fsm.SetState) == "function" then fsm:SetState("Throw")
        elseif type(fsm.ChangeState) == "function" then fsm:ChangeState("Throw")
        else error("No method") end
    end)
    
    setLog(string.format(
        "Method: fsm:Set\nFSM methods: %s\nState before: %s\nResult: %s",
        #methods > 0 and table.concat(methods, ", ") or "none",
        tostring(fsm.State),
        ok and "✅ no error" or ("❌ " .. tostring(err))
    ))
end)

