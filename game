local function GetAllTools()
    local tools = {}
    local upvals = getupvalues(m_BackpackClient.GetToolById)
    for _, v in pairs(upvals) do
        if type(v) == "table" then
            for _, tool in pairs(v) do
                if type(tool) == "table" and tool.Store then
                    table.insert(tools, tool)
                end
            end
        end
    end
    return tools
end

local function IsKnifeTool(tool)
    if not tool.Setup then return false end
    local b = tool.Setup.ToolBehaviour
    return type(b) == "string" and b:lower():find("knife", 1, true) ~= nil
end

