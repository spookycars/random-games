-- Sharp Anti-Cheat Trigger Finder
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

print("[Finder] Kick trigger detector loaded. Waiting for a kick attempt...")

-- Hook the __namecall metamethod to intercept all method calls
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    
    -- Check if the method name contains "kick" (case-insensitive)
    if typeof(method) == "string" and method:lower():find("kick") then
        print("========================================")
        print("[Finder] KICK ATTEMPT DETECTED!")
        print("Method Name: " .. method)
        print("Target Instance: " .. tostring(self))
        
        -- This is the most important part: the stack trace
        print("--- STACK TRACE ---")
        local trace = debug.traceback()
        print(trace)
        print("========================================")
        
        -- Block the kick by returning nil instead of calling the original function
        return nil 
    end
    
    return oldNamecall(self, ...)
end)

setreadonly(mt, true)
