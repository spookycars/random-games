RunService.Stepped:Connect(function()
    if not settings.antiTrap then return end
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    local myPos = root.Position
    local traps = scanTraps(myPos, settings.trapAvoidRadius)
    if #traps == 0 then return end
    local closest, dist = getClosestTrap(myPos, traps)
    if not closest or dist > settings.trapAvoidRadius then return end
    local avoidTarget = computeAvoidTarget(myPos, closest.Position)
    if hum.MoveDirection.Magnitude > 0.1 or dist < settings.trapDangerRadius then
        hum:MoveTo(avoidTarget)
    end
end)

-- ============================================================
-- PREDICTIVE DODGE v2 — BROADER DETECTION + INSTANT DASH
-- Old version: MoveTo (walk speed) + narrow WorldModel check.
-- New version: BodyVelocity 130 studs/s + 4-stud teleport.
-- ~7x faster than walk speed. Detection scans all descendants.
-- ============================================================
local predictiveDodge = {
    cooldownUntil = 0,
    lastDir = 1,
    activeDash = nil,
    dashSpeed = 130,
    dashDuration = 0.18,
}

local KNIFE_KEYWORDS = { "knife", "blade", "dagger", "throw", "bayonet", "cleaver" }

local function nameIsKnife(n)
    n = string.lower(n)
    for _, kw in ipairs(KNIFE_KEYWORDS) do
        if n:find(kw) then return true end
    end
    return false
end

local function enemyHasKnifeDrawn(emodel, gc)
    -- 1. Any BasePart or Tool anywhere on the enemy model
    for _, d in ipairs(emodel:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Tool") then
            if nameIsKnife(d.Name) then return true end
        end
    end
    -- 2. Equipped Tool directly under model
    local equipped = emodel:FindFirstChildOfClass("Tool")
    if equipped and nameIsKnife(equipped.Name) then return true end
    -- 3. Player.Backpack — only counts if actually equipped (parented to char)
    if gc and gc.Player then
        local bp = gc.Player:FindFirstChild("Backpack")
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") and tool.Parent == emodel and nameIsKnife(tool.Name) then
                    return true
                end
            end
        end
    end
    return false
end

local function willAimAtMe(enemyPos, enemyLook, myPos, tolerance)
    local toMe = myPos - enemyPos
    toMe = Vector3.new(toMe.X, 0, toMe.Z)
    if toMe.Magnitude < 0.1 then return true end
    local lookFlat = Vector3.new(enemyLook.X, 0, enemyLook.Z)
    if lookFlat.Magnitude < 0.1 then return false end
    lookFlat = lookFlat.Unit
    local proj = toMe:Dot(lookFlat)
    if proj <= 0 then return false end
    local closest = lookFlat * proj
    return (toMe - closest).Magnitude <= tolerance
end

local function enemyRelationshipIsEnemy(gc)
    local ok, rel = pcall(function() return gc.GamePlayer:GetLocalRelationship() end)
    if ok and rel then return rel == "Enemy" end
    local me = LocalPlayer
    local them = gc.Player
    if me.TeamColor and them and them.TeamColor then
        return them.TeamColor ~= me.TeamColor
    end
    return true
end

local function findKnifeThreat(myPos)
    local best, bestDist = nil, math.huge
    for _, gc in ipairs(m_GameCharacterController.GetGameCharacters()) do
        if gc.Player == LocalPlayer then continue end
        if not enemyRelationshipIsEnemy(gc) then continue end
        local c = gc.Character
        if not c or not c.IsAlive or not c.Model then continue end
        local emodel = c.Model
        local eRoot = emodel:FindFirstChild("HumanoidRootPart")
        if not eRoot then continue end
        local dist = (eRoot.Position - myPos).Magnitude
        if dist > settings.dodgeThreatRange then continue end
        if settings.ignoreForcefield and HasForceField(emodel) then continue end
        if not enemyHasKnifeDrawn(emodel, gc) then continue end
        local toMe = myPos - eRoot.Position
        if toMe.Magnitude < 0.1 then continue end
        local facing = eRoot.CFrame.LookVector
        local flatToMe = Vector3.new(toMe.X, 0, toMe.Z)
        if flatToMe.Magnitude < 0.1 then flatToMe = Vector3.new(1,0,0) end
        local facingDot = facing:Dot(flatToMe.Unit)
        local willHit = (facingDot >= settings.dodgeFacingDot)
            or willAimAtMe(eRoot.Position, facing, myPos, 6)
            or dist < 8
        if not willHit then continue end
        if dist < bestDist then
            bestDist = dist
            best = { root = eRoot, dist = dist, facingDot = facingDot, gameChar = gc }
        end
    end
    return best
end

local function performDash(dir, distance)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    if predictiveDodge.activeDash and predictiveDodge.activeDash.Parent then
        predictiveDodge.activeDash:Destroy()
    end

    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then return end
    dir = dir.Unit

    -- Instant micro-teleport (4 studs) for guaranteed displacement
    local teleOffset = dir * 4
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { char }
    local hit = workspace:Raycast(root.Position, teleOffset, rp)
    if not hit then
        pcall(function() root.CFrame = root.CFrame + teleOffset end)
    end

    -- Sustained dash via BodyVelocity (fast, ignores walk speed)
    local bv = Instance.new("BodyVelocity")
    bv.Name = "SharpDash"
    bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
    bv.Velocity = dir * predictiveDodge.dashSpeed
    bv.P = 10000
    bv.Parent = root
    predictiveDodge.activeDash = bv

    pcall(function() hum:MoveTo(root.Position + dir * distance) end)

    local dashRef = bv
    task.delay(predictiveDodge.dashDuration, function()
        if dashRef.Parent then dashRef:Destroy() end
        if predictiveDodge.activeDash == dashRef then
            predictiveDodge.activeDash = nil
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if not settings.predictiveDodge then
        if predictiveDodge.activeDash and predictiveDodge.activeDash.Parent then
            predictiveDodge.activeDash:Destroy()
        end
        predictiveDodge.activeDash = nil
        return
    end
    if tick() < predictiveDodge.cooldownUntil then return end
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end
    local myPos = root.Position
    local threat = findKnifeThreat(myPos)
    if not threat then return end

    local toThreat = Vector3.new(
        threat.root.Position.X - myPos.X, 0,
        threat.root.Position.Z - myPos.Z
    )
    if toThreat.Magnitude < 0.1 then toThreat = Vector3.new(1, 0, 0) end
    local perp = Vector3.new(-toThreat.Unit.Z, 0, toThreat.Unit.X)

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { char }
    local origin = myPos + Vector3.new(0, 2.5, 0)
    local probe = settings.dodgeStrafeDistance
    local hitA = workspace:Raycast(origin, perp * probe, rp)
    local hitB = workspace:Raycast(origin, -perp * probe, rp)

    local dir
    if hitA and not hitB then dir = -perp
    elseif hitB and not hitA then dir = perp
    elseif hitA and hitB then dir = -toThreat.Unit  -- boxed in → back away
    else dir = perp * predictiveDodge.lastDir end

    predictiveDodge.lastDir = -predictiveDodge.lastDir
    performDash(dir, probe)
    predictiveDodge.cooldownUntil = tick() + settings.dodgeCooldown
end)

