local lines = {}
local function add(s) table.insert(lines, s) end

add("=== MY COOKIE STORE — SIMPLE CATALOG ===")
add("Format: name | WxD | resize")
add("W = width in squares, D = depth in squares")
add("")

-- Collect all attribute names to see what's available
local attrFreq = {}
local totalItems = #ItemsFolder:GetChildren()
for _, item in ipairs(ItemsFolder:GetChildren()) do
    for k, _ in pairs(item:GetAttributes()) do
        attrFreq[k] = (attrFreq[k] or 0) + 1
    end
end

-- Show attribute names so we can identify "resizable" field
add("--- ATTRIBUTES FOUND ACROSS ALL ITEMS ---")
local attrList = {}
for k, count in pairs(attrFreq) do
    table.insert(attrList, {name = k, count = count})
end
table.sort(attrList, function(a, b) return a.name:lower() < b.name:lower() end)
for _, a in ipairs(attrList) do
    add(string.format("  %-25s %d/%d items", a.name, a.count, totalItems))
end
add("")

-- Resize detection - try common attribute names
local RESIZE_NAMES = {
    "Resizable", "Scalable", "CanResize", "CanScale", "Resize",
    "Scale", "MaxScale", "GridScale", "FootprintMax", "MaxFootprint",
    "Variants", "Variant", "PropV", "Sizes", "SizeOptions"
}

local function getResizeFlag(item)
    for _, name in ipairs(RESIZE_NAMES) do
        local v = item:GetAttribute(name)
        if v ~= nil then
            if type(v) == "boolean" then
                return v and "yes" or "no"
            elseif type(v) == "number" then
                return "yes(" .. tostring(v) .. ")"
            elseif type(v) == "string" then
                return v
            end
        end
    end
    return "?"
end

-- Build item list
add("--- ITEMS ---")
local items = ItemsFolder:GetChildren()
table.sort(items, function(a, b)
    local an = (a:GetAttribute("ItemId") or a.Name):lower()
    local bn = (b:GetAttribute("ItemId") or b.Name):lower()
    return an < bn
end)

for _, item in ipairs(items) do
    local name = item:GetAttribute("ItemId") or item.Name
    local w = item:GetAttribute("FootprintW") or 1
    local d = item:GetAttribute("FootprintD") or 1
    local resize = getResizeFlag(item)
    add(string.format("%-35s | %dx%d | %s", name, w, d, resize))
end

