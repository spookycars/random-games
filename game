local currentTargetHighlight = nil
local currentTargetModel = nil

local function clearTargetHighlight()
    if currentTargetHighlight then
        pcall(function() currentTargetHighlight:Destroy() end)
        currentTargetHighlight = nil
    end
    currentTargetModel = nil
end

local function applyTargetHighlight(model)
    if currentTargetModel == model then return end
    clearTargetHighlight()
    if not model then return end
    local h = Instance.new("Highlight")
    h.FillColor = Color3.fromRGB(255, 50, 50)
    h.FillTransparency = 0.5
    h.OutlineColor = Color3.new(1, 1, 1)
    h.OutlineTransparency = 0
    h.Adornee = model
    h.Parent = chamFolder
    currentTargetHighlight = h
    currentTargetModel = model
end

RunService.Heartbeat:Connect(function()
    if not settings.espEnabled then
        for _, data in pairs(espData) do
            if data.billboard then data.billboard.Enabled = false end
            if data.highlight then data.highlight.Enabled = false end
        end
        clearTargetHighlight()
        return
    end

    local localChar = LocalPlayer.Character
    local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local localAlive = localHum and localHum.Health > 0

    for gameChar, data in pairs(espData) do
        local gcPlayer = gameChar.Player
        if gcPlayer == LocalPlayer then
            if data.billboard then data.billboard.Enabled = false end
            if data.highlight then data.highlight.Enabled = false end
            data.model = nil; data.head = nil
            continue
        end

        local char = gameChar.Character
        local model = char and char.Model
        local head = model and model:FindFirstChild("Head")
        local hum = model and model:FindFirstChildOfClass("Humanoid")

        local modelReady = model ~= nil and model.Parent ~= nil
        local alive = false
        if hum and hum.Health > 0 then alive = true
        elseif char and char.IsAlive then alive = true end

        if not modelReady or not head or not alive then
            if data.billboard then data.billboard.Enabled = false end
            if data.highlight then data.highlight.Enabled = false end
            data.model = nil; data.head = nil
            continue
        end

        local adorneeStale = (data.model ~= model) or (data.head ~= head)
        data.billboard.Adornee = head
        data.highlight.Adornee = model
        data.model = model
        data.head = head

        local ok, rel = pcall(function() return gameChar.GamePlayer:GetLocalRelationship() end)
        local isEnemy = (ok and rel == "Enemy")

        local shouldShow = true
        if settings.espEnemyOnly and not isEnemy then shouldShow = false end
        if settings.espTeamOnly and isEnemy then shouldShow = false end

        if shouldShow and localRoot and char.RootPart then
            local dist = (char.RootPart.Position - localRoot.Position).Magnitude
            if dist > settings.espMaxDistance then shouldShow = false end
        end

        if not shouldShow then
            if data.billboard then data.billboard.Enabled = false end
            if data.highlight then data.highlight.Enabled = false end
            continue
        end

        local color = isEnemy and settings.espEnemyColor or settings.espTeamColor
        local hp = gameChar.DamageReceiver and gameChar.DamageReceiver.Health or (hum and hum.Health) or 0
        local hpMax = gameChar.DamageReceiver and gameChar.DamageReceiver.MaxHealth or (hum and hum.MaxHealth) or 100
        local dist = 0
        if localAlive and localRoot and char.RootPart then
            dist = math.floor((char.RootPart.Position - localRoot.Position).Magnitude)
        end

        local parts = {}
        if settings.espNames and gcPlayer then table.insert(parts, gcPlayer.Name) end
        if settings.espDistance then table.insert(parts, dist .. "m") end
        if settings.espHealth then table.insert(parts, math.floor(hp) .. "/" .. math.floor(hpMax) .. "hp") end

        data.label.Text = table.concat(parts, " | ")
        data.label.TextColor3 = color
        data.billboard.Enabled = true

        if settings.espChams then
            data.highlight.FillColor = color
            data.highlight.OutlineColor = color
            if adorneeStale then
                data.highlight.Enabled = false
                data.highlight.Enabled = true
            elseif not data.highlight.Enabled then
                data.highlight.Enabled = true
            end
        else
            data.highlight.Enabled = false
        end
    end

    if settings.targetHighlight then
        local head, _, gameChar = GetClosestHead(true, false)
        if gameChar and gameChar.Character and gameChar.Character.IsAlive and gameChar.Character.Model then
            applyTargetHighlight(gameChar.Character.Model)
        else
            clearTargetHighlight()
        end
    else
        clearTargetHighlight()
    end
end)

