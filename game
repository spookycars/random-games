local function ResolveWeaponType(tool)
    if not tool.Setup then return nil end
    local behaviour = tool.Setup.ToolBehaviour
    if type(behaviour) ~= "string" then return nil end
    local b = behaviour:lower()
    if b:find("knife", 1, true) or b:find("melee", 1, true) or b:find("blade", 1, true) then return "knife" end
    if b:find("gun", 1, true) or b:find("firearm", 1, true) or b:find("pistol", 1, true)
       or b:find("rifle", 1, true) or b:find("shotgun", 1, true) or b:find("weapon", 1, true) then return "gun" end
    return nil
end

local function scanTraps(centerPos, radius)
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    local excludeList = {}
    if LocalPlayer.Character then table.insert(excludeList, LocalPlayer.Character) end
    overlapParams.FilterDescendantsInstances = excludeList
    local parts = workspace:GetPartBoundsInRadius(centerPos, radius, overlapParams)
    local traps = {}
    for _, part in ipairs(parts) do
        if isTrapPart(part) then table.insert(traps, part) end
    end
    return traps
end

local function getClosestTrap(myPos, traps)
    local best, bestDist = nil, math.huge
    for _, t in ipairs(traps) do
        local d = (t.Position - myPos).Magnitude
        if d < bestDist then best, bestDist = t, d end
    end
    return best, bestDist
end

local function computeAvoidTarget(myPos, trapPos)
    local away = Vector3.new(myPos.X - trapPos.X, 0, myPos.Z - trapPos.Z)
    if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
    local awayDir = away.Unit
    local perpA = Vector3.new(-awayDir.Z, 0, awayDir.X)
    local perpB = Vector3.new(awayDir.Z, 0, -awayDir.X)
    local blendA = (perpA + awayDir * 0.6).Unit
    local blendB = (perpB + awayDir * 0.6).Unit
    local trapRayParams = RaycastParams.new()
    trapRayParams.FilterType = Enum.RaycastFilterType.Exclude
    local excludeList = {}
    if LocalPlayer.Character then table.insert(excludeList, LocalPlayer.Character) end
    trapRayParams.FilterDescendantsInstances = excludeList
    local probeDist = 8
    local origin = myPos + Vector3.new(0, 2.5, 0)
    local function isClear(dir) return workspace:Raycast(origin, dir * probeDist, trapRayParams) == nil end
    if isClear(blendA) then return myPos + blendA * probeDist
    elseif isClear(blendB) then return myPos + blendB * probeDist
    else return myPos + awayDir * probeDist end
end

local TRAP_BARRIER_KEYWORDS = {
    BearTrap = {"beartrap", "bear trap"},
    Goop = {"goop"}, Curse = {"curse"},
    ShockMine = {"shockmine", "shock mine"},
    TeleportGate = {"teleportgate", "teleport gate"},
}

local trapBarrierFolder = Instance.new("Folder")
trapBarrierFolder.Name = "SharpTrapBarriers"
trapBarrierFolder.Parent = workspace

local function findTrapTriggerPart(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local lower = part.Name:lower()
            if lower == "hitdetect" or lower == "trigger" or lower == "touch" or lower == "sensor" then return part end
        end
    end
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part:FindFirstChildOfClass("TouchInterest") then return part end
    end
    return model:FindFirstChild("Root") or model:FindFirstChildOfClass("BasePart")
end

local function createTrapBarrier(model)
    local trigger = findTrapTriggerPart(model)
    if not trigger then return end
    local barrier = Instance.new("Part")
    barrier.Name = "SharpBarrier_" .. model.Name
    barrier.Size = trigger.Size + Vector3.new(3, 3, 3)
    barrier.CFrame = trigger.CFrame
    barrier.Anchored = true; barrier.CanCollide = true
    barrier.Transparency = 1; barrier.Material = Enum.Material.SmoothPlastic
    barrier.Parent = trapBarrierFolder
end

local function updateTrapBarriers()
    for _, v in pairs(trapBarrierFolder:GetChildren()) do v:Destroy() end
    if not settings.trapBarriers then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        local model = obj:IsA("Model") and obj or (obj:IsA("BasePart") and obj.Parent)
        if model then
            local name = model.Name:lower()
            for key, keywords in pairs(TRAP_BARRIER_KEYWORDS) do
                if settings.trapBarrierTypes[key] then
                    for _, kw in ipairs(keywords) do
                        if name:find(kw, 1, true) then createTrapBarrier(model); break end
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while true do task.wait(0.5); pcall(updateTrapBarriers) end
end)

local chargeStartedAt = {}
local lastKnifeThrow = 0
local lastGunShot = 0

local function ResetCharges()
    for k in pairs(chargeStartedAt) do chargeStartedAt[k] = nil end
end

local function FireKnife(tool)
    local fsm = tool.Store.FSM
    if not fsm then return false end
    local state = tostring(fsm.State or "")
    if state == "Fire" or state == "Throw" or state == "Equip" or state == "Preview" then return false end
    if tick() - lastKnifeThrow < settings.knifeTriggerDelay then return false end
    if state == "Charge" then
        chargeStartedAt[tool] = nil
        if type(fsm.Set) == "function" then
            local ok = pcall(fsm.Set, fsm, "Throw")
            if ok then lastKnifeThrow = tick() end
            return ok
        end
        return false
    end
    if state == "ChargeHold" or state == "Idle" then
        if not chargeStartedAt[tool] then
            chargeStartedAt[tool] = tick()
            if state == "Idle" and type(fsm.Set) == "function" then pcall(fsm.Set, fsm, "ChargeHold") end
            return false
        end
        if tick() - chargeStartedAt[tool] < settings.chargeTime then return false end
        chargeStartedAt[tool] = nil
        if type(fsm.Set) == "function" then
            local ok = pcall(fsm.Set, fsm, "Throw")
            if ok then lastKnifeThrow = tick() end
            return ok
        end
        return false
    end
    return false
end

local function FireGun(tool)
    local fsm = tool.Store.FSM
    if not fsm then return false end
    local state = tostring(fsm.State or "")
    if state == "Reload" then
        if settings.autoReload and type(fsm.Set) == "function" then pcall(fsm.Set, fsm, "Idle"); return true end
        return false
    end
    if state == "Fire" or state == "Throw" then return false end
    if tick() - lastGunShot < 0.1 then return false end
    if type(fsm.Set) == "function" then
        local ok = pcall(fsm.Set, fsm, "Fire")
        if ok then lastGunShot = tick() end
        return ok
    end
    return false
end

local function TryFire()
    for _, tool in ipairs(GetAllTools()) do
        if tool.Equipped and tool.Store and tool.Store.FSM then
            local wType = ResolveWeaponType(tool)
            if wType == "knife" then FireKnife(tool)
            elseif wType == "gun" then FireGun(tool) end
        end
    end
end

local CROSSHAIR_RADIUS = 60
local function IsCrosshairOnEnemy()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local localChar = LocalPlayer.Character
    if not localChar then return false end
    for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
        if gameChar.Player == LocalPlayer then continue end
        if gameChar.GamePlayer:GetLocalRelationship() ~= "Enemy" then continue end
        local char = gameChar.Character
        if not char or not char.IsAlive or not char.Model then continue end
        if settings.ignoreForcefield and HasForceField(char.Model) then continue end
        local head = char.Model:FindFirstChild("Head")
        if not head then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist > CROSSHAIR_RADIUS then continue end
        local origin = Camera.CFrame.Position
        local direction = head.Position - origin
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {localChar, char.Model}
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        if workspace:Raycast(origin, direction, params) == nil then return true end
    end
    return false
end

local CHARGE_GRACE_PERIOD = 0.3
local lastValidTargetTime = 0

task.spawn(function()
