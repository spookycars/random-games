    local cur = default
    hi.FocusLost:Connect(function()
        local hex = hi.Text:gsub("#",""):upper()
        if #hex == 6 and hex:match("^%x+$") then
            cur = Color3.fromRGB(tonumber(hex:sub(1,2),16), tonumber(hex:sub(3,4),16), tonumber(hex:sub(5,6),16))
            sw.BackgroundColor3 = cur
            if callback then callback(cur) end
        else
            hi.Text = string.format("%02X%02X%02X", math.floor(cur.R*255), math.floor(cur.G*255), math.floor(cur.B*255))
        end
    end)
