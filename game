mkButton("Test 3\nChildren", 0.5, 0.25, -54, Color3.fromRGB(180, 100, 60), function()
    setStatus("Test 3: Dumping tool children...", Color3.fromRGB(255, 160, 60))
    local tool = GetEquippedTool()
    if not tool then
        addLog("[Test 3] ❌ No tool equipped")
        return
    end
    addLog("")
    addLog("[Test 3] Tool: " .. tool.Name)
    for _, child in ipairs(tool:GetChildren()) do
        addLog(string.format("  %s (%s)", child.Name, child.ClassName))
        for _, sub in ipairs(child:GetChildren()) do
            addLog(string.format("    └ %s (%s)", sub.Name, sub.ClassName))
        end
    end
    setStatus("✓ Children dumped", Color3.fromRGB(120, 220, 140))
    copyAll()
end)

