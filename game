-- Test 4: Full structure dump
mkBtn("Test 4: Dump Tool Structure", 184, Color3.fromRGB(150, 60, 150), function()
    local tool = findEquippedKnife()
    if not tool then
        setLog("❌ No knife equipped.")
        return
    end
    
    local lines = {}
    table.insert(lines, "=== TOOL ===")
    for k, v in pairs(tool) do
        if k ~= "Store" and k ~= "Setup" and type(v) ~= "function" then
            table.insert(lines, k .. " = " .. tostring(v))
        end
    end
    table.insert(lines, "")
    table.insert(lines, "=== SETUP ===")
    if tool.Setup then
        for k, v in pairs(tool.Setup) do
            table.insert(lines, k .. " = " .. tostring(v))
        end
    end
    table.insert(lines, "")
    table.insert(lines, "=== STORE ===")
    if tool.Store then
        for k, v in pairs(tool.Store) do
            table.insert(lines, k .. " (" .. type(v) .. ")")
        end
    end
    setLog(table.concat(lines, "\n"))
end)

-- Test 5: Dump FSM structure
mkBtn("Test 5: Dump FSM Structure", 230, Color3.fromRGB(150, 100, 60), function()
    local tool = findEquippedKnife()
    if not tool then
        setLog("❌ No knife equipped.")
        return
    end
    local fsm = tool.Store and tool.Store.FSM
    if not fsm then
        setLog("❌ No FSM.")
        return
    end
    
    local lines = {}
    table.insert(lines, "=== FSM PROPERTIES ===")
    for k, v in pairs(fsm) do
        if type(v) ~= "function" then
            table.insert(lines, k .. " = " .. tostring(v))
        end
    end
    table.insert(lines, "")
    table.insert(lines, "=== FSM METHODS ===")
    local mt = getmetatable(fsm)
    if mt then
        for k, v in pairs(mt) do
            if type(v) == "function" then
                table.insert(lines, k .. "()")
            end
        end
    end
    if fsm._states then
        table.insert(lines, "")
        table.insert(lines, "=== STATES ===")
        for name, _ in pairs(fsm._states) do
            table.insert(lines, name)
        end
    end
    setLog(table.concat(lines, "\n"))
end)

