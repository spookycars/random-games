-- ===================== AIMBOT =====================
local function aimbotIsVisible(targetPart, targetModel)
    if not settings.aimbot.wallCheck or not targetModel then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit
    local distance = (targetPart.Position - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, targetModel}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    for i = 1, settings.aimbot.wallCheckPrecision do
        local offset = Vector3.new(math.random(-30,30)/100, math.random(-30,30)/100, math.random(-30,30)/100)
        local result = workspace:Raycast(origin + offset, direction * distance, params)
        if result and not result.Instance:IsDescendantOf(targetModel) then return false end
    end
    return true
end

local function getAimbotPart(model)
    local partName = settings.aimbot.targetPart
    if partName == "Torso" then
        return model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")
    end
    return model:FindFirstChild(partName)
end

local function aimbotValidTarget(gameChar)
    if gameChar.Player == LocalPlayer then return false end
    if settings.aimbot.teamCheck and gameChar.GamePlayer:GetLocalRelationship() ~= "Enemy" then return false end
    local char = gameChar.Character
    if not char or not char.IsAlive then return false end
    local model = char.Model
    if not model then return false end
    local part = getAimbotPart(model)
    if not part then return false end
    return true, char, part
end

local function aimbotFindTarget()
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local localChar = LocalPlayer.Character
    if not localChar then return nil end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    local best, bestScore = nil, math.huge
    for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
        local valid, char, part = aimbotValidTarget(gameChar)
        if valid then
            local dist = (part.Position - localRoot.Position).Magnitude
            if dist <= settings.aimbot.maxDistance and aimbotIsVisible(part, char.Model) then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                    if fovDist <= settings.aimbot.fov then
                        local score = settings.aimbot.prioritizeClosest and dist or fovDist
                        if score < bestScore then bestScore = score; best = gameChar end
                    end
                end
            end
        end
    end
    return best
end

local function aimbotUpdate()
    if not settings.aimbot.enabled then targetLocked = nil; return end
    if targetLocked then
        local valid, char, part = aimbotValidTarget(targetLocked)
        if not valid or not aimbotIsVisible(part, char.Model) then targetLocked = nil end
    end
    if not targetLocked then targetLocked = aimbotFindTarget() end
    if targetLocked then
        local valid, char, part = aimbotValidTarget(targetLocked)
        if valid and part then
            local currentCF = Camera.CFrame
            local newCF = CFrame.new(currentCF.Position, part.Position)
            Camera.CFrame = currentCF:Lerp(newCF, math.clamp(settings.aimbot.smoothness, 0.01, 1))
        end
    end
end

RunService.RenderStepped:Connect(aimbotUpdate)
