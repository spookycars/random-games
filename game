end

-- ============ DISCOVER TOOLS ============
local function GetAllTools()
    local tools = {}
    local upvals = getupvalues(m_BackpackClient.GetToolById)
    for _, v in pairs(upvals) do
        if type(v) == "table" then
            for _, tool in pairs(v) do
                if type(tool) == "table" and tool.Store then
                    table.insert(tools, tool)
                end
            end
        end
    end
    return tools
end

local function TryFire()
    local fired = {}
    for _, tool in ipairs(GetAllTools()) do
        if tool.Equipped and tool.Store and tool.Store.FSM then
            local fsm = tool.Store.FSM
            local behaviour = tool.Setup and tool.Setup.ToolBehaviour or "?"
            local state = tostring(fsm.State or "?")
            local ok, err = pcall(function()
                if type(fsm.Set) == "function" then fsm:Set("Throw")
                elseif type(fsm.ForceSetState) == "function" then fsm:ForceSetState("Throw")
                elseif type(fsm.HandleEvent) == "function" then fsm:HandleEvent("Throw")
                end
            end)
            table.insert(fired, string.format("%s (state=%s) → %s", behaviour, state, ok and "OK" or tostring(err)))
        end
    end
    return fired
end

-- ============ HEAD SCANNER ============
local CROSSHAIR_RADIUS = 60

local function ScanHeads()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local lines = {}
    local passCount = 0
    local total = 0

    for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
        if gameChar.Player == LP then continue end
        local rel = "?"
        pcall(function() rel = gameChar.GamePlayer:GetLocalRelationship() end)

        local char = gameChar.Character
        local alive = char and char.IsAlive
        local model = char and char.Model
        local head = model and model:FindFirstChild("Head")

        total = total + 1

        if not head then
            -- Try to find any part on the model
            local foundPart = nil
            if model then
                for _, d in ipairs(model:GetChildren()) do
                    if d:IsA("BasePart") then foundPart = d break end
                end
            end
            table.insert(lines, string.format(
                "%s | %s | NO HEAD%s",
                gameChar.Player.Name, rel,
                foundPart and (" (first part: " .. foundPart.Name .. ")") or ""
            ))
            continue
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            table.insert(lines, string.format(
                "%s | %s | head OFFSCREEN (pos %.0f,%.0f,%.0f)",
                gameChar.Player.Name, rel,
                head.Position.X, head.Position.Y, head.Position.Z
            ))
            continue
        end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        local within = dist <= CROSSHAIR_RADIUS
        if within and rel == "Enemy" and alive then passCount = passCount + 1 end

        table.insert(lines, string.format(
            "%s | %s | %s | screen(%.0f,%.0f) | center-dist %.0f%s",
            gameChar.Player.Name,
            rel,
            alive and "alive" or "dead",
            screenPos.X, screenPos.Y,
            dist,
            within and " ✓ IN RADIUS" or ""
        ))
    end

    return lines, passCount, total, center
end

-- ============ LIVE UPDATE ============
task.spawn(function()
    while true do
        task.wait(0.3)
        pcall(function()
            local lines, pass, total, center = ScanHeads()
            logLines = {}
            table.insert(logLines, string.format(
                "=== TRIGGERBOT DIAGNOSTIC ===\nViewport: %dx%d | Center: (%.0f,%.0f) | Radius: %dpx\nEnemies: %d | In crosshair: %d\n",
                Camera.ViewportSize.X, Camera.ViewportSize.Y,
                center.X, center.Y,
                CROSSHAIR_RADIUS,
                total, pass
            ))
            for _, line in ipairs(lines) do
                table.insert(logLines, line)
            end
            logBox.Text = table.concat(logLines, "\n")
            if pass > 0 then
                status.Text = string.format("🟢 %d enemy head(s) in crosshair — triggerbot SHOULD fire", pass)
                status.TextColor3 = Color3.fromRGB(120, 220, 140)
            else
                status.Text = string.format("🔴 0 in crosshair — aimbot not locked or head off center (%d tracked)", total)
                status.TextColor3 = Color3.fromRGB(220, 100, 100)
            end
        end)
    end
end)

