-- ============ LOG HELPERS ============
local logLines = {}
local function addLog(text)
    table.insert(logLines, text)
    logBox.Text = table.concat(logLines, "\n")
end

local function setStatus(text, color)
    status.Text = text
    status.TextColor3 = color or Color3.fromRGB(255, 200, 80)
end

local function copyAll()
    local text = table.concat(logLines, "\n")
    local ok = false
    pcall(function() if setclipboard then setclipboard(text); ok = true end end)
    if not ok then pcall(function() if toclipboard then toclipboard(text); ok = true end end) end
    if not ok and writefile then
        pcall(writefile, "knife_diag.txt", text)
        pcall(writefile, "/storage/emulated/0/knife_diag.txt", text)
    end
    return ok
end

-- ============ DIRECT TOOL SCAN (no getupvalues) ============
local function GetEquippedTool()
    local char = LP.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            return child
        end
    end
    return nil
end

local function GetAllBackpackTools()
    local tools = {}
    local backpack = LP:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(tools, child)
            end
        end
    end
    local char = LP.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(tools, child)
            end
        end
    end
    return tools
end

-- ============ INITIAL SCAN ============
task.spawn(function()
    task.wait(1)
    addLog("=== KNIFE DIAGNOSTIC ===")
    addLog("")

    local backpack = LP:FindFirstChildOfClass("Backpack")
    addLog("Backpack: " .. (backpack and "found" or "MISSING"))
    if backpack then
        local count = 0
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                count = count + 1
                addLog(string.format("  [backpack] %s (%s)", child.Name, child.ClassName))
            end
        end
        addLog("Backpack tools: " .. count)
    end

    local char = LP.Character
    addLog("")
    addLog("Character: " .. (char and "found" or "MISSING"))
    if char then
        local count = 0
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                count = count + 1
                addLog(string.format("  [equipped] %s (%s)", child.Name, child.ClassName))
            end
        end
        addLog("Equipped tools: " .. count)
    end

    local equipped = GetEquippedTool()
    addLog("")
    if equipped then
        addLog("=== EQUIPPED TOOL ===")
        addLog("Name: " .. equipped.Name)
        addLog("Class: " .. equipped.ClassName)
        addLog("")
        addLog("Properties:")
        for k, v in pairs(equipped) do
            if type(v) ~= "function" and k ~= "Parent" then
                local val = type(v) == "Instance" and ("[" .. v.ClassName .. "] " .. v.Name) or tostring(v)
                addLog("  " .. k .. " = " .. val)
            end
        end
        addLog("")
        addLog("Attributes:")
        local attrs = equipped:GetAttributes()
        local hasAttrs = false
        for k, v in pairs(attrs) do
            hasAttrs = true
            addLog("  " .. k .. " = " .. tostring(v))
        end
        if not hasAttrs then addLog("  (none)") end

        addLog("")
        addLog("Children:")
        for _, child in ipairs(equipped:GetChildren()) do
            addLog(string.format("  %s (%s)", child.Name, child.ClassName))
            if child:IsA("ModuleScript") then
                addLog("    → ModuleScript, may have tool logic")
            end
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                addLog("    → Remote! Could be the throw trigger")
            end
        end
        setStatus("✅ Tool found: " .. equipped.Name, Color3.fromRGB(120, 220, 140))
    else
        addLog("❌ NO TOOL EQUIPPED")
        addLog("Equip the knife, then tap Test 1.")
        setStatus("❌ Equip a knife first", Color3.fromRGB(255, 100, 100))
    end

    addLog("")
    addLog("Copy status: " .. (copyAll() and "✓ copied" or "✗ copy failed"))
end)

