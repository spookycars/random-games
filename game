-- ===================== TRAP ESP =====================
local trapEspFolder = Instance.new("Folder")
trapEspFolder.Name = "SharpTrapESPData"
trapEspFolder.Parent = espFolder

local trapEspCache = {}

local function cleanupAllTrapEsp()
    for _, hl in pairs(trapEspCache) do
        pcall(function() hl:Destroy() end)
    end
    trapEspCache = {}
end

local function updateTrapEsp()
    if not settings.trapEsp then cleanupAllTrapEsp(); return end
    local traps = findTrapsInRange(settings.trapEspMaxDistance, false)
    local seen = {}
    for _, t in ipairs(traps) do
        seen[t.adornee] = true
        local existing = trapEspCache[t.adornee]
        if existing then
            existing.FillColor = settings.trapEspColor
            existing.OutlineColor = settings.trapEspColor
        else
            local hl = Instance.new("Highlight")
            hl.Name = "TrapESP_" .. t.adornee.Name
            hl.FillColor = settings.trapEspColor
            hl.FillTransparency = 0.55
            hl.OutlineColor = settings.trapEspColor
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = t.adornee
            hl.Parent = trapEspFolder
            trapEspCache[t.adornee] = hl
        end
    end
    for adornee, hl in pairs(trapEspCache) do
        if not seen[adornee] then
            pcall(function() hl:Destroy() end)
            trapEspCache[adornee] = nil
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        pcall(updateTrapEsp)
    end
end)

-- ============================================================
--  NEW: AUTO WEAPON SWAP (knife → gun → knife)
-- ============================================================
local swapState = {
    inProgress = false,
    startedAt = 0,
    swapBackAt = 0,
    lastSwapTime = 0,
    wasThrowing = false,
}

local function GetEquippedKnife()
    for _, tool in ipairs(GetAllTools()) do
        if tool.Equipped and ResolveWeaponType(tool) == "knife" then return tool end
    end
    return nil
end

local function GetEquippedGun()
    for _, tool in ipairs(GetAllTools()) do
        if tool.Equipped and ResolveWeaponType(tool) == "gun" then return tool end
    end
    return nil
end

local function FindToolOfType(wType)
    for _, tool in ipairs(GetAllTools()) do
        if ResolveWeaponType(tool) == wType then return tool end
    end
    return nil
end

local function FindActualTool(wrappedTool)
    if not wrappedTool then return nil end
    if typeof(wrappedTool.Tool) == "Instance" and wrappedTool.Tool:IsA("Tool") then return wrappedTool.Tool end
    if wrappedTool.Store and typeof(wrappedTool.Store.Tool) == "Instance" and wrappedTool.Store.Tool:IsA("Tool") then
        return wrappedTool.Store.Tool
    end
    local name = (wrappedTool.Setup and wrappedTool.Setup.Name) or wrappedTool.Name
    if not name then return nil end
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") and child.Name == name then return child end
        end
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and child.Name == name then return child end
        end
    end
    return nil
end

local function EquipTool(wrappedTool)
    if not wrappedTool then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local actual = FindActualTool(wrappedTool)
    if not actual then return false end
    local ok = pcall(function() hum:EquipTool(actual) end)
    return ok
end

local function CountEnemiesInRadius(radius)
    local localChar = LocalPlayer.Character
    if not localChar then return 0 end
    local root = localChar:FindFirstChild("HumanoidRootPart")
    if not root then return 0 end
    local count = 0
    for _, gameChar in ipairs(m_GameCharacterController.GetGameCharacters()) do
        if gameChar.Player == LocalPlayer then continue end
        if gameChar.GamePlayer:GetLocalRelationship() ~= "Enemy" then continue end
        local char = gameChar.Character
        if not char or not char.IsAlive or not char.RootPart then continue end
        if HasForceField(char.Model) then continue end
        if (char.RootPart.Position - root.Position).Magnitude <= radius then
            count = count + 1
        end
    end
    return count
end

local function KnifeWillBeReadyIn(seconds)
    local knife = GetEquippedKnife()
    if not knife then
        knife = FindToolOfType("knife")
        if not knife then return true end
        return true
    end
    local fsm = knife.Store and knife.Store.FSM
    if not fsm then return true end
    local state = tostring(fsm.State or "")
    if state == "Idle" and not chargeStartedAt[knife] then return true end
    if chargeStartedAt[knife] then
        local remaining = settings.chargeTime - (tick() - chargeStartedAt[knife])
        if remaining <= 0 then return true end
        return remaining <= seconds
    end
    local sinceThrow = tick() - lastKnifeThrow
    local totalCycle = settings.knifeTriggerDelay + settings.chargeTime + 0.2
    local remaining = totalCycle - sinceThrow
    if remaining <= 0 then return true end
    return remaining <= seconds
end

local function SwapBackToKnife()
    swapState.inProgress = false
    swapState.swapBackAt = 0
    local knife = FindToolOfType("knife")
    if knife then
        EquipTool(knife)
        swapState.lastSwapTime = tick()
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)

        if not settings.weaponSwap.enabled then
            swapState.wasThrowing = false
            swapState.inProgress = false
            swapState.swapBackAt = 0
            continue
        end

        -- Handle pending swap-back to knife
        if swapState.inProgress then
            -- Cancel if user manually swapped away from gun
            if not GetEquippedGun() then
                swapState.inProgress = false
                swapState.swapBackAt = 0
                continue
            end

            local heldTime = tick() - swapState.startedAt
            local minHold = settings.weaponSwap.switchBackDelay
            local maxHold = settings.weaponSwap.maxGunHoldTime

            if heldTime >= maxHold then
                SwapBackToKnife()
            elseif heldTime >= minHold and KnifeWillBeReadyIn(0.15) then
                SwapBackToKnife()
            end
            continue
        end

        -- Must be on knife to consider swapping
        local equipped = GetEquippedKnife()
        if not equipped then
            swapState.wasThrowing = false
            continue
        end

        local fsm = equipped.Store and equipped.Store.FSM
        if not fsm then continue end
        local state = tostring(fsm.State or "")

        -- Detect throw completion (was in Throw, now not)
        local throwComplete = false
        if state == "Throw" then
            swapState.wasThrowing = true
        elseif swapState.wasThrowing then
            swapState.wasThrowing = false
            throwComplete = true
        end

        -- Cooldown between swaps
        if tick() - swapState.lastSwapTime < settings.weaponSwap.swapCooldown then continue end

        local enemies = CountEnemiesInRadius(settings.weaponSwap.enemyRadius)

        local shouldSwap = false

        if throwComplete and enemies >= 1 then
            -- Miss OR another player there → swap
            if not KnifeWillBeReadyIn(0.15) then
                shouldSwap = true
            end
        elseif throwComplete and enemies == 0 and settings.weaponSwap.useDefensiveSwap then
            -- Clean kill + no enemies → swap only if knife is down for a long time
            if not KnifeWillBeReadyIn(settings.weaponSwap.defensiveSwapThreshold) then
                shouldSwap = true
            end
        end

        if shouldSwap then
            local gun = FindToolOfType("gun")
            if gun then
                EquipTool(gun)
                swapState.inProgress = true
                swapState.startedAt = tick()
                swapState.lastSwapTime = tick()
            end
        end
    end
end)

