-- APPROACH 1: Try requiring the Items ModuleScript
add("--- ATTEMPT 1: require(Shared.Items) ---")
local itemsModule = RS:FindFirstChild("CookieStore")
itemsModule = itemsModule and itemsModule:FindFirstChild("Shared")
itemsModule = itemsModule and itemsModule:FindFirstChild("Items")

local data = nil
if itemsModule then
    local ok, result = pcall(require, itemsModule)
    if ok and type(result) == "table" then
        data = result
        add("✓ require succeeded, table with " .. #(function() local t = 0 for _ in pairs(result) do t = t + 1 end return t end)() .. " entries")
    else
        add("✗ require failed: " .. tostring(result))
    end
else
    add("✗ Items module not found")
end

-- APPROACH 2: Try requiring Furniture module
if not data then
    add("")
    add("--- ATTEMPT 2: require(Shared.Furniture) ---")
    local furn = RS.CookieStore.Shared:FindFirstChild("Furniture")
    if furn and furn:IsA("ModuleScript") then
        local ok, result = pcall(require, furn)
        if ok and type(result) == "table" then
            data = result
            add("✓ require succeeded")
        else
            add("✗ require failed: " .. tostring(result))
        end
    end
end

-- APPROACH 3: Read Assets.Items folder directly
if not data then
    add("")
    add("--- ATTEMPT 3: Read Assets.Items folder ---")
    local assetsItems = RS.CookieStore:FindFirstChild("Assets")
    assetsItems = assetsItems and assetsItems:FindFirstChild("Items")

    if assetsItems then
        local children = assetsItems:GetChildren()
        add("✓ Found " .. #children .. " children in Assets.Items")
        add("")

        for _, child in ipairs(children) do
            local info = { name = child.Name, className = child.ClassName }

            -- Try part size
            if child:IsA("Model") then
                local part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                if part then
                    info.size = string.format("%.2f x %.2f x %.2f", part.Size.X, part.Size.Y, part.Size.Z)
                end
            elseif child:IsA("BasePart") then
                info.size = string.format("%.2f x %.2f x %.2f", child.Size.X, child.Size.Y, child.Size.Z)
            end

            -- Attributes
            local attrs = child:GetAttributes()
            local attrList = {}
            for k, v in pairs(attrs) do
                table.insert(attrList, k .. "=" .. tostring(v))
            end
            if #attrList > 0 then
                info.attrs = table.concat(attrList, ", ")
            end

            -- Decal/Texture for icon ID
            local decal = child:FindFirstChildWhichIsA("Decal") or child:FindFirstChildWhichIsA("Texture")
            if decal and decal.Texture then
                info.texture = decal.Texture
            end

            add(string.format("%-40s | %s%s%s", 
                info.name, 
                info.className,
                info.size and (" | size: " .. info.size) or "",
                info.attrs and (" | " .. info.attrs) or ""))
        end
    else
        add("✗ Assets.Items not found")
    end
end

-- If we got data from module, walk it
if data then
    add("")
    add("--- MODULE DATA ---")

    local function walk(tbl, depth)
        if depth > 3 then return end
        for k, v in pairs(tbl) do
            if type(v) == "table" then
                -- Check if this looks like an item (has name or size)
                local itemName = v.Name or v.DisplayName or v.Id or tostring(k)
                local itemSize = v.Size or v.GridSize or v.TileSize or v.Width or v.Height
                local itemPrice = v.Price or v.Cost or v.PriceCoins

                if itemSize or itemPrice then
                    local sizeStr = "?"
                    if type(itemSize) == "table" then
                        if itemSize.X then
                            sizeStr = string.format("%s x %s x %s", tostring(itemSize.X), tostring(itemSize.Y), tostring(itemSize.Z))
                        elseif itemSize[1] then
                            sizeStr = tostring(itemSize[1]) .. " x " .. tostring(itemSize[2] or "?")
                        end
                    else
                        sizeStr = tostring(itemSize)
                    end
                    add(string.format("%-40s | size: %s%s", 
                        tostring(itemName), 
                        sizeStr,
                        itemPrice and (" | price: " .. tostring(itemPrice)) or ""))
                else
                    walk(v, depth + 1)
                end
            end
        end
    end
    walk(data, 0)
end

