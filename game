-- LIST STATES
mkBtn("📋 List all FSM states", -104, Color3.fromRGB(60, 120, 200), function()
    local tool = getEquippedKnife()
    if not tool then addLog("❌ No knife"); return end
    local fsm = tool.Store.FSM
    addLog("")
    addLog("=== FSM STATE LIST ===")
    addLog("Current: " .. tostring(fsm.State))
    if fsm._states then
        local names = {}
        for k in pairs(fsm._states) do table.insert(names, tostring(k)) end
        table.sort(names)
        for _, n in ipairs(names) do
            addLog("  • " .. n)
        end
    else
        addLog("  (no _states table)")
        -- Try metatable
        local mt = getmetatable(fsm)
        if mt then
            for k in pairs(mt) do addLog("  mt." .. tostring(k)) end
        end
    end
    copyAll()
end)

-- TRY A SINGLE STATE + VERIFY
local function tryState(name)
    local tool = getEquippedKnife()
    if not tool then addLog("❌ No knife"); return end
    local fsm = tool.Store.FSM
    local before = tostring(fsm.State)
    local ok, err = pcall(function()
        if type(fsm.Set) == "function" then fsm:Set(name)
        elseif type(fsm.ForceSetState) == "function" then fsm:ForceSetState(name)
        elseif type(fsm.HandleEvent) == "function" then fsm:HandleEvent(name) end
    end)
    task.wait(0.3)
    local after = tostring(fsm.State)
    local changed = before ~= after
    addLog(string.format("Set('%s') | %s → %s | %s",
        name, before, after,
        not ok and ("ERR: " .. tostring(err))
        or changed and "✓ STATE CHANGED"
        or "✗ state unchanged"))
    copyAll()
end

